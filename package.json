{
  "name": "site-em-terra-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview:local": "astro dev --open",
    "import:blog": "node scripts/import-wp-blog.mjs",
    "sync:gallery": "node scripts/sync-gallery-images.mjs",
    "optimize:og": "node scripts/optimize-og-image.mjs",
    "generate:redirects": "node scripts/generate-project-redirects.mjs",
    "generate:image-sitemap": "node scripts/generate-image-sitemap.mjs",
    "prebuild": "node scripts/generate-project-redirects.mjs && node scripts/generate-image-sitemap.mjs",
    "build": "astro build",
    "postbuild": "pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.7"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "sharp": "^0.35.5"
  }
}
