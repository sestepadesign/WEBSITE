# Cloudflare Pages doesn't set long-lived cache headers by default — every
# response comes back as `max-age=0, must-revalidate` unless we say
# otherwise here (confirmed by fetching /_astro/*.css and /videos/*.webp
# directly). Astro content-hashes everything under /_astro/, so those files
# are safe to cache forever; images/fonts/videos change rarely and aren't
# hashed, so they get a long max-age plus revalidation instead of `immutable`.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/portfolio/*
  Cache-Control: public, max-age=2592000, must-revalidate

/videos/*
  Cache-Control: public, max-age=2592000, must-revalidate

/images/*
  Cache-Control: public, max-age=2592000, must-revalidate

/favicon*
  Cache-Control: public, max-age=2592000, must-revalidate
