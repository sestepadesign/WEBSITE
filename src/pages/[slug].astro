---
import ProjectDetail from '../components/ProjectDetail.astro';
import BlogPost from '../components/site/BlogPost.astro';
import { projects } from '../data/projects';
import { getProjectStaticPathParams } from '../lib/urls';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const SITE = 'https://design.sestepa.com';
  const postSlug = (id: string) => id.replace(/\.md$/, '').split('/').pop()!;

  const projectPaths = getProjectStaticPathParams('en').map(({ params, props }) => {
    const project = projects.find((p) => p.slug === props.projectSlug)!;
    return {
      params,
      props: {
        kind: 'project' as const,
        project,
        canonicalPath: props.canonicalPath,
      },
    };
  });

  const all = await getCollection('blog', ({ data }) => !data.draft);
  const enPosts = all
    .filter((p) => p.data.lang === 'en')
    .sort((a, b) => new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime());

  // Slugs that also have es + de translations → emit hreflang alternates.
  const translated = new Set(
    Object.entries(
      all.reduce<Record<string, Set<string>>>((acc, p) => {
        const s = postSlug(p.id);
        (acc[s] ??= new Set()).add(p.data.lang);
        return acc;
      }, {}),
    )
      .filter(([, langs]) => langs.has('es') && langs.has('de'))
      .map(([s]) => s),
  );

  const blogPaths = enPosts.map((post, index) => {
    const slug = postSlug(post.id);
    const prev = index > 0 ? enPosts[index - 1] : null;
    const next = index < enPosts.length - 1 ? enPosts[index + 1] : null;
    // Always explicit — blog posts aren't in SITE_PAGES, so the default
    // getAlternatePath() would otherwise fall back to the homepage.
    const alternates = translated.has(slug)
      ? [
          { hreflang: 'en', href: `${SITE}/${slug}/` },
          { hreflang: 'es', href: `${SITE}/es/blog/${slug}/` },
          { hreflang: 'de', href: `${SITE}/de/blog/${slug}/` },
          { hreflang: 'x-default', href: `${SITE}/${slug}/` },
        ]
      : [
          { hreflang: 'en', href: `${SITE}/${slug}/` },
          { hreflang: 'x-default', href: `${SITE}/${slug}/` },
        ];

    return {
      params: { slug },
      props: {
        kind: 'blog' as const,
        post,
        alternates,
        prev: prev ? { title: prev.data.title, href: `/${postSlug(prev.id)}/` } : null,
        next: next ? { title: next.data.title, href: `/${postSlug(next.id)}/` } : null,
      },
    };
  });

  return [...projectPaths, ...blogPaths];
}

const props = Astro.props;
---

{props.kind === 'project' ? (
  <ProjectDetail project={props.project} lang="en" canonicalPath={props.canonicalPath} />
) : (
  <BlogPost post={props.post} lang="en" prev={props.prev} next={props.next} alternates={props.alternates} />
)}
