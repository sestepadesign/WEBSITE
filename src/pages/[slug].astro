---
import ProjectDetail from '../components/ProjectDetail.astro';
import { projects } from '../data/projects';
import { getProjectStaticPathParams } from '../lib/urls';
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const projectPaths = getProjectStaticPathParams('en').map(({ params, props }) => {
    const project = projects.find((p) => p.slug === props.projectSlug)!;
    return {
      params,
      props: {
        kind: 'project' as const,
        project,
        canonicalPath: props.canonicalPath,
      },
    };
  });

  const posts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
  posts.sort((a, b) => new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime());

  const blogPaths = posts.map((post, index) => {
    const slug = post.id.replace(/\.md$/, '').split('/').pop()!;
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

    return {
      params: { slug },
      props: {
        kind: 'blog' as const,
        post,
        prevPost: prevPost ? {
          slug: prevPost.id.replace(/\.md$/, '').split('/').pop()!,
          title: prevPost.data.title
        } : null,
        nextPost: nextPost ? {
          slug: nextPost.id.replace(/\.md$/, '').split('/').pop()!,
          title: nextPost.data.title
        } : null,
      },
    };
  });

  return [...projectPaths, ...blogPaths];
}

const props = Astro.props;
const { prevPost, nextPost } = props;
let BlogContent: Awaited<ReturnType<typeof render>>['Content'] | null = null;

if (props.kind === 'blog') {
  const rendered = await render(props.post);
  BlogContent = rendered.Content;
}

const wordCount = props.kind === 'blog' ? props.post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

{props.kind === 'project' ? (
  <ProjectDetail
    project={props.project}
    lang="en"
    canonicalPath={props.canonicalPath}
  />
) : (
  <Layout
    title={props.post.data.title.replace(/&#038;/g, '&').replace(/&#8217;/g, "'") + " | S'Estepa Design"}
    description={props.post.data.description}
    lang="en"
    image={props.post.data.image ?? '/portfolio/finca-garden-campos-mallorca/garden-design-mallorca-finca-garden-campos-mallorca-sestepa.webp'}
    hreflangLocales={['en']}
    noindex={props.post.data.noindex}
  >
    <section class="blog-hero" style="position: relative; min-height: 640px; height: 78vh; display: flex; align-items: center; justify-content: center; text-align: center; color: white; overflow: hidden; padding: 150px 1rem 3.5rem;">
      <div class="video-container" aria-hidden="true" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
        <video autoplay loop muted playsinline preload="none" aria-label="Decorative background video" style="width: 100%; height: 100%; object-fit: cover;">
          <source src="/videos/hero-bg.mp4" type="video/mp4" />
        </video>
        <div class="overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.4); z-index: 2;"></div>
      </div>
      
      {props.kind === 'blog' && (
        <div class="blog-navigation-v3" style="position: absolute; top: 140px; left: 50%; transform: translateX(-50%); z-index: 10; display: flex; align-items: center; justify-content: space-between; width: 90%; max-width: 450px; padding: 0.6rem 0; border-top: 1px solid rgba(255, 255, 255, 0.2); border-bottom: 1px solid rgba(255, 255, 255, 0.2); font-family: 'Jost', sans-serif; font-size: 0.75rem; letter-spacing: 0.25em; text-transform: uppercase;">
          {prevPost ? (
            <a href={`/${prevPost.slug}/`} class="nav-arrow prev" title={prevPost.title} style="color: rgba(255, 255, 255, 0.65); text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: color 0.3s ease;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: -0.1em;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
              <span class="nav-text-desktop" style="font-size: 0.65rem; font-weight: 400; opacity: 0.8;">PREVIOUS</span>
            </a>
          ) : (
            <span class="nav-arrow-disabled" style="width: 80px; display: inline-block;"></span>
          )}
          
          <a href="/blog/" class="nav-blog-link" style="color: rgba(255, 255, 255, 0.95); text-decoration: none; font-weight: 500; padding-left: 0.25em; transition: color 0.3s ease;">
            JOURNAL
          </a>
          
          {nextPost ? (
            <a href={`/${nextPost.slug}/`} class="nav-arrow next" title={nextPost.title} style="color: rgba(255, 255, 255, 0.65); text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: color 0.3s ease;">
              <span class="nav-text-desktop" style="font-size: 0.65rem; font-weight: 400; opacity: 0.8;">NEXT</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: -0.1em;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          ) : (
            <span class="nav-arrow-disabled" style="width: 80px; display: inline-block;"></span>
          )}
        </div>
      )}
      
      <div class="hero-content" style="position: relative; z-index: 3; max-width: 860px; padding: 1rem;">
        <h1 set:html={props.post.data.title} style="font-family: var(--font-serif); font-size: clamp(2rem, 4.6vw, 3.6rem); line-height: 1.12; margin-bottom: 1.5rem; font-weight: 400; color: white;" />
        {props.kind === 'blog' && (
          <span class="ux-meta" style="font-family: var(--font-sans); text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.85rem; opacity: 0.9; display: inline-block; border-top: 1px solid rgba(255, 255, 255, 0.3); padding-top: 1rem; margin-top: 0.5rem; color: white;">
            S'ESTEPA STUDIO &nbsp;&middot;&nbsp; {readingTime} MIN READ
          </span>
        )}
      </div>
    </section>

    <article class="container section-padding blog-post" id="blog-content">
      <div class="blog-content" set:html={BlogContent ? '' : ''}>
        {BlogContent && <BlogContent />}
      </div>
    </article>
  </Layout>
)}

<style is:global>
  @media (max-width: 768px) {
    .blog-navigation-v3 {
      top: 110px !important;
      max-width: 280px !important;
    }
    .blog-navigation-v3 .nav-text-desktop {
      display: none !important;
    }
    .blog-navigation-v3 .nav-arrow-disabled {
      width: 20px !important;
    }
  }
  .blog-navigation-v3 a:hover {
    color: #ffffff !important;
  }
</style>



