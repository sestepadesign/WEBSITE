---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import Schema from '../components/Schema.astro';
import imageDimensions from '../data/image-dimensions.json';

const DevMobileSimulator = import.meta.env.DEV
  ? (await import('../components/DevMobileSimulator.astro')).default
  : null;
import {
  SITE_NAME,
  SITE_LOCALES,
  getHreflangAlternates,
  type SiteLocale,
  GTM_ID,
  GTAG_ID,
  GOOGLE_ADS_ID,
  GOOGLE_ADS_CONVERSION_WHATSAPP,
  GOOGLE_ADS_CONVERSION_EMAIL,
  GA4_ID,
  COOKIEYES_CLIENT_ID,
  META_PIXEL_ID,
  META_DOMAIN_VERIFICATION
} from '../lib/seo';
import { PAGE_OG_IMAGES } from '../data/site-urls';
import { resolvePageIdFromPath } from '../lib/urls';

const DEFAULT_SITE_OG_IMAGE = '/portfolio/sant-llorenc/images/garden-design-mallorca-sestepa-landscape-design-sant-llorenc-18.webp';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'es' | 'de';
  /** Path to OG image, e.g. /portfolio/sant-llorenc/images/garden-design-mallorca-sestepa-landscape-design-sant-llorenc-18.webp */
  image?: string;
  /** Override canonical path (aliases, homepage). */
  canonicalPath?: string;
  /** If set, adds meta refresh after full OG head (legacy). */
  redirectTo?: string;
  /** Locales with a real alternate page (default: all). Blog posts EN-only use ['en']. */
  hreflangLocales?: SiteLocale[];
  /**
   * Explicit alternate URLs, used when the localised page does NOT follow the
   * standard SITE_PAGES / project path mapping (e.g. blog posts, where EN lives
   * at /slug/ but ES/DE at /es/blog/slug/). Overrides hreflangLocales entirely.
   */
  hreflangAlternates?: { hreflang: string; href: string }[];
  /** Hidden pages (SEO archive) — noindex, not linked in nav */
  noindex?: boolean;
  /** Optional LCP image preloads with media queries */
  preloadImages?: { href: string; media?: string; type?: string }[];
}

const {
  title,
  description,
  lang,
  image = DEFAULT_SITE_OG_IMAGE,
  canonicalPath: canonicalPathProp,
  redirectTo,
  hreflangLocales = SITE_LOCALES,
  hreflangAlternates,
  noindex = false,
  preloadImages = [],
} = Astro.props;

const site = Astro.site!;
const canonicalPath = canonicalPathProp ?? redirectTo ?? Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, site);

const pageId = resolvePageIdFromPath(canonicalPath);
const defaultOgImage = pageId ? PAGE_OG_IMAGES[pageId]?.[lang] : undefined;
const resolvedImage = image !== DEFAULT_SITE_OG_IMAGE ? image : (defaultOgImage ?? image);
const ogImage = new URL(resolvedImage, site);

const ogImageDims = (imageDimensions as Record<string, { w?: number; h?: number }>)[resolvedImage];
const ogImageWidth = String(ogImageDims?.w ?? 1200);
const ogImageHeight = String(ogImageDims?.h ?? 630);
const getOgImageMimeType = (imgPath: string): string => {
  const lower = imgPath.toLowerCase();
  if (lower.endsWith('.webp')) return 'image/webp';
  if (lower.endsWith('.png')) return 'image/png';
  if (lower.endsWith('.avif')) return 'image/avif';
  return 'image/jpeg';
};
const ogImageMimeType = getOgImageMimeType(resolvedImage);

const ogLocales: Record<typeof lang, string> = {
  en: 'en_US',
  es: 'es_ES',
  de: 'de_DE',
};

const hreflangLinks = redirectTo
  ? []
  : hreflangAlternates && hreflangAlternates.length
    ? [
        ...hreflangAlternates,
        ...(hreflangAlternates.some((a) => a.hreflang === 'x-default')
          ? []
          : [{ hreflang: 'x-default', href: hreflangAlternates.find((a) => a.hreflang === 'en')?.href ?? canonicalURL.href }]),
      ]
    : getHreflangAlternates(canonicalPath, site, hreflangLocales);
const ogAlternateLocales = hreflangAlternates && hreflangAlternates.length
  ? hreflangAlternates.filter((a) => a.hreflang !== lang && a.hreflang !== 'x-default').map((a) => ogLocales[a.hreflang as typeof lang]).filter(Boolean)
  : hreflangLocales.filter((l) => l !== lang).map((l) => ogLocales[l]);
const ogLocaleAlternates = ogAlternateLocales;

// Feed the header's language switcher explicit per-locale URLs when the page
// carries them (blog posts) — otherwise getAlternatePath() sends every locale
// link to that locale's homepage.
const headerLangAlternates = hreflangAlternates && hreflangAlternates.length
  ? Object.fromEntries(
      hreflangAlternates
        .filter((a) => a.hreflang !== 'x-default')
        .map((a) => [a.hreflang, a.href]),
    )
  : undefined;
---

<!DOCTYPE html>
<html lang={lang} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <Fragment set:html={'<meta name="p:domain_verify" content="8e8392b25f273ca4c1953774b5e0363f"/>'} />
    <meta name="facebook-domain-verification" content={META_DOMAIN_VERIFICATION} />

    <link rel="preload" as="font" href="/fonts/jost-variable.woff2" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" href="/fonts/cormorant-garamond-variable.woff2" type="font/woff2" crossorigin="anonymous" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon-192x192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <link rel="canonical" href={canonicalURL} />

    {hreflangLinks.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="S'Estepa Design" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {ogLocaleAlternates.map((locale) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:type" content={ogImageMimeType} />
    <meta property="og:image:alt" content={title} />

    <link rel="image_src" href={ogImage.href} />
    <meta itemprop="image" content={ogImage.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sestepadesign" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    {redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}

    {!noindex && <Schema canonicalPath={canonicalPath} />}

    {preloadImages.map((item) => (
      <link
        rel="preload"
        as="image"
        href={item.href}
        media={item.media}
        type={item.type}
        fetchpriority="high"
      />
    ))}
  </head>
  <body>
    {!import.meta.env.DEV && (
      <>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
      </>
    )}
    {redirectTo ? (
      <p style="display:none">Redirecting to <a href={redirectTo}>{redirectTo}</a></p>
    ) : (
      <div class="site-wrapper">
        <Header lang={lang} langAlternates={headerLangAlternates} />
        <main id="main-content">
          <slot />
        </main>
        <Footer lang={lang} />
        <SearchModal lang={lang} />
        {import.meta.env.DEV && DevMobileSimulator && <DevMobileSimulator />}
      </div>
    )}
    {!redirectTo && (
      <script is:inline define:vars={{ GOOGLE_ADS_CONVERSION_WHATSAPP, GOOGLE_ADS_CONVERSION_EMAIL }}>
        document.addEventListener('DOMContentLoaded', () => {
          document.body.addEventListener('click', (e) => {
            const anchor = e.target.closest('a');
            if (!anchor || !anchor.href) return;

            const pathname = window.location.pathname;
            const host = window.location.hostname;
            const isProdHost = host === 'design.sestepa.com' || host === 'www.design.sestepa.com';

            // 1. WhatsApp click conversion & lead logging
            if (anchor.href.includes('wa.me')) {
              const waSessionKey = 'sestepa_wa_logged';
              let alreadyLogged = false;
              try {
                alreadyLogged = sessionStorage.getItem(waSessionKey) === '1';
                if (!alreadyLogged) {
                  sessionStorage.setItem(waSessionKey, '1');
                }
              } catch (_) {}

              if (!alreadyLogged && isProdHost) {
                const waEventId = `wa_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
                if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
                  window.gtag('event', 'conversion', {
                    send_to: GOOGLE_ADS_CONVERSION_WHATSAPP,
                    transport_type: 'beacon'
                  });
                  window.gtag('event', 'whatsapp_click', {
                    event_category: 'engagement',
                    event_label: pathname,
                    transport_type: 'beacon'
                  });
                }
                if (typeof window !== 'undefined' && typeof window.fbq === 'function') {
                  window.fbq('track', 'Contact', {
                    content_name: pathname,
                    content_category: 'whatsapp'
                  }, { eventID: waEventId });
                }
                if (window.dataLayer) {
                  window.dataLayer.push({
                    event: 'whatsapp_click',
                    page: pathname,
                    event_id: waEventId
                  });
                }
                const payload = {
                  name: "WhatsApp Click",
                  email: "---",
                  subject: "WhatsApp",
                  message: `Click en el botón de WhatsApp desde: ${pathname}`
                };
                fetch("/api/leads", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ type: "whatsapp", payload, event_id: waEventId }),
                  keepalive: true
                }).catch(err => console.error("WhatsApp click logging failed:", err));
              }
            }

            // 2. E-mail (mailto:) click conversion (defer mailto: navigation until event_callback so browser does not abort 1p-conversion ping)
            if (anchor.href.toLowerCase().startsWith('mailto:')) {
              const mailtoHref = anchor.href;
              const emailSessionKey = 'sestepa_email_logged';
              let emailAlreadyLogged = false;
              try {
                emailAlreadyLogged = sessionStorage.getItem(emailSessionKey) === '1';
                if (!emailAlreadyLogged) {
                  sessionStorage.setItem(emailSessionKey, '1');
                }
              } catch (_) {}

              if (!emailAlreadyLogged && isProdHost) {
                e.preventDefault();
                let navigated = false;
                const openMailClient = () => {
                  if (!navigated) {
                    navigated = true;
                    window.location.href = mailtoHref;
                  }
                };
                const fallbackTimer = setTimeout(openMailClient, 450);

                const emailEventId = `em_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
                if (window.dataLayer) {
                  window.dataLayer.push({
                    event: 'email_click',
                    page: pathname,
                    event_id: emailEventId
                  });
                }
                if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
                  window.gtag('event', 'email_click', {
                    event_category: 'engagement',
                    event_label: pathname,
                    transport_type: 'beacon'
                  });
                  window.gtag('event', 'conversion', {
                    send_to: GOOGLE_ADS_CONVERSION_EMAIL,
                    transport_type: 'beacon',
                    event_callback: () => {
                      clearTimeout(fallbackTimer);
                      openMailClient();
                    }
                  });
                } else {
                  clearTimeout(fallbackTimer);
                  openMailClient();
                }
              }
            }

            // 3. Phone (tel:) click telemetry (defer tel: navigation briefly so beacon completes)
            if (anchor.href.toLowerCase().startsWith('tel:')) {
              const telHref = anchor.href;
              const telSessionKey = 'sestepa_tel_logged';
              let telAlreadyLogged = false;
              try {
                telAlreadyLogged = sessionStorage.getItem(telSessionKey) === '1';
                if (!telAlreadyLogged) {
                  sessionStorage.setItem(telSessionKey, '1');
                }
              } catch (_) {}

              if (!telAlreadyLogged && isProdHost) {
                e.preventDefault();
                let telNavigated = false;
                const openTelClient = () => {
                  if (!telNavigated) {
                    telNavigated = true;
                    window.location.href = telHref;
                  }
                };
                const telTimer = setTimeout(openTelClient, 350);

                const telEventId = `tel_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
                if (window.dataLayer) {
                  window.dataLayer.push({
                    event: 'phone_click',
                    page: pathname,
                    event_id: telEventId
                  });
                }
                if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
                  window.gtag('event', 'phone_click', {
                    event_category: 'engagement',
                    event_label: pathname,
                    transport_type: 'beacon',
                    event_callback: () => {
                      clearTimeout(telTimer);
                      openTelClient();
                    }
                  });
                } else {
                  clearTimeout(telTimer);
                  openTelClient();
                }
              }
            }
          });
        });
      </script>
    )}

    <!-- Production-only Analytics, Consent Mode v2, CookieYes, GTM & Meta Pixel (skip localhost / preview hosts) -->
    <script is:inline define:vars={{ GTM_ID, GTAG_ID, GOOGLE_ADS_ID, GA4_ID, COOKIEYES_CLIENT_ID, META_PIXEL_ID }}>
      (function () {
        var host = window.location.hostname;
        if (host !== 'design.sestepa.com' && host !== 'www.design.sestepa.com') {
          return;
        }

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

        // Google Consent Mode v2 Default State (with url_passthrough for ad click attribution)
        window.gtag('consent', 'default', {
          'ad_storage': 'denied',
          'analytics_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'personalization_storage': 'denied',
          'functionality_storage': 'denied',
          'security_storage': 'granted',
          'wait_for_update': 500
        });
        window.gtag('set', 'ads_data_redaction', true);
        window.gtag('set', 'url_passthrough', true);

        // CookieYes banner
        var cyScript = document.createElement('script');
        cyScript.id = 'cookieyes';
        cyScript.async = true;
        cyScript.src = 'https://cdn-cookieyes.com/client_data/' + COOKIEYES_CLIENT_ID + '/script.js';
        document.head.appendChild(cyScript);

        // Google tag (gtag.js) — GT-WKTZS5C routes to GA4 (G-DZ9ZSG3VH0) and Ads (AW-795871100) with Enhanced Conversions
        var gtagScript = document.createElement('script');
        gtagScript.async = true;
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + GTAG_ID;
        document.head.appendChild(gtagScript);
        window.gtag('js', new Date());
        window.gtag('config', GTAG_ID);
        window.gtag('config', GA4_ID);
        window.gtag('config', GOOGLE_ADS_ID, { 'allow_enhanced_conversions': true });

        // Google Tag Manager
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0];
          var dl = l != 'dataLayer' ? '&l=' + l : '';
          var scr = d.createElement(s);
          scr.async = true;
          scr.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(scr, f);
        })(window, document, 'script', 'dataLayer', GTM_ID);

        // Meta Pixel (S'Estepa Design — 1185880420805434) with CookieYes GDPR synchronization
        if (META_PIXEL_ID) {
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

          var hasCookieYesAdConsent = /(?:^|;\s*)cookieyes-consent=[^;]*advertisement:yes/i.test(document.cookie || '');
          window.fbq('consent', hasCookieYesAdConsent ? 'grant' : 'revoke');
          window.fbq('init', META_PIXEL_ID);
          window.fbq('track', 'PageView');

          document.addEventListener('cookieyes_consent_update', function (event) {
            var detail = (event && event.detail) || {};
            var accepted = Array.isArray(detail.accepted) ? detail.accepted : [];
            if (accepted.indexOf('advertisement') !== -1) {
              window.fbq('consent', 'grant');
              window.fbq('track', 'PageView');
            } else {
              window.fbq('consent', 'revoke');
            }
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: var(--color-sand-light);
  }

  main {
    flex-grow: 1;
  }
</style>



