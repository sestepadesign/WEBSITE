---
import { ui } from '../data/translations';

interface Props {
  lang: 'en' | 'es' | 'de';
  id?: string;
}

const { lang, id = 'inquiryForm' } = Astro.props;

const t = (key: keyof typeof ui[typeof lang]) => {
  return ui[lang][key] || key;
};

const statusMessages = {
  en: {
    sending: 'Sending...',
    success: 'Thank you. Your message has been sent successfully.',
    error: 'We could not send your message at this moment. Please try again or contact us directly via WhatsApp or sofia@sestepa.com.',
  },
  es: {
    sending: 'Enviando...',
    success: 'Gracias. Su mensaje ha sido enviado correctamente.',
    error: 'No pudimos enviar su mensaje en este momento. Por favor, inténtelo de nuevo o contáctenos por WhatsApp o sofia@sestepa.com.',
  },
  de: {
    sending: 'Wird gesendet...',
    success: 'Vielen Dank. Ihre Nachricht wurde erfolgreich gesendet.',
    error: 'Ihre Nachricht konnte derzeit nicht gesendet werden. Bitte versuchen Sie es erneut oder kontaktieren Sie uns per WhatsApp oder sofia@sestepa.com.',
  },
}[lang];
---

<form
  class="contact-form"
  action="#"
  method="POST"
  id={id}
  data-msg-sending={statusMessages.sending}
  data-msg-success={statusMessages.success}
  data-msg-error={statusMessages.error}
>
  <!-- Anti-bot honeypot trap field (hidden from human visitors & assistive technologies) -->
  <div class="ohnohoney" aria-hidden="true">
    <label for={`${id}_company_website`}>Please leave this field empty</label>
    <input type="text" id={`${id}_company_website`} name="company_website" tabindex="-1" autocomplete="new-password" value="" />
  </div>

  <div class="form-group">
    <label for={`${id}_name`}>{t('contact.form.name')}</label>
    <input type="text" id={`${id}_name`} name="name" autocomplete="name" required placeholder=" " />
  </div>

  <div class="form-group">
    <label for={`${id}_email`}>{t('contact.form.email')}</label>
    <input type="email" id={`${id}_email`} name="email" autocomplete="email" required placeholder=" " />
  </div>

  <div class="form-group">
    <label for={`${id}_phone`}>{t('contact.form.phone')}</label>
    <input type="tel" id={`${id}_phone`} name="phone" autocomplete="tel" placeholder=" " />
  </div>

  <div class="form-group">
    <label for={`${id}_subject`}>{t('contact.form.location')}</label>
    <input type="text" id={`${id}_subject`} name="subject" required placeholder={t('contact.form.location_placeholder')} />
  </div>

  <div class="form-group">
    <label for={`${id}_garden_size`}>{t('contact.form.size')}</label>
    <input type="text" id={`${id}_garden_size`} name="garden_size" placeholder={t('contact.form.size_placeholder')} />
  </div>

  <div class="form-group">
    <label for={`${id}_message`}>{t('contact.form.message')}</label>
    <textarea id={`${id}_message`} name="message" rows="6" required placeholder=" "></textarea>
  </div>

  <button type="submit" class="submit-btn">
    {t('contact.form.submit')} &rarr;
  </button>
  
  <div class="form-status" id={`${id}_status`} aria-live="polite"></div>
</form>

<script>
  // Google Apps Script Web App Integration with Multi-Layer Anti-Bot Protection & Google Ads Telemetry
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    const statusDiv = form.querySelector('.form-status') as HTMLElement | null;
    if (!statusDiv) return;

    const msgSending = form.dataset.msgSending || 'Sending...';
    const msgSuccess = form.dataset.msgSuccess || 'Thank you. Your message has been sent successfully.';
    const msgError = form.dataset.msgError || 'We could not send your message at this moment.';

    const pageRenderTime = Date.now();
    let hasUserInteracted = false;
    let firstInteractionTime = 0;

    // Track genuine human interaction events
    const markInteraction = () => {
      if (!hasUserInteracted) {
        hasUserInteracted = true;
        firstInteractionTime = Date.now();
      }
    };

    ['focusin', 'input', 'keydown', 'pointerdown', 'touchstart'].forEach((evt) => {
      form.addEventListener(evt, markInteraction, { passive: true });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
      const originalText = submitBtn.innerHTML;
      submitBtn.textContent = msgSending;
      submitBtn.disabled = true;
      
      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((val, key) => { data[key] = String(val); });

      const now = Date.now();
      const elapsedTotal = now - pageRenderTime;
      const elapsedInteraction = firstInteractionTime > 0 ? (now - firstInteractionTime) : 0;

      // 1. Honeypot check: Automated bots blindly fill invisible/hidden fields
      const honeypotVal = (data.company_website || '').trim();
      const isHoneypotTriggered = honeypotVal.length > 0;

      // 2. Timing check: Automated bots submit immediately (< 2.5s total or < 1.2s since focus)
      const isTooFast = elapsedTotal < 2500 || (hasUserInteracted && elapsedInteraction < 1200);

      // 3. Behavioral check: Form submitted without registering human input events
      const isUnnaturalInteraction = !hasUserInteracted;

      // 4. Semantic spam check: Mass outbound cold-marketing pitches
      const textToScan = `${data.name || ''} ${data.email || ''} ${data.subject || ''} ${data.message || ''}`.toLowerCase();
      const spamRegex = /\b(internet marketing company|seo service|seo services|backlinks|guest post|increase your sales ranking|online business ranking|whatsapp marketing)\b/i;
      const isSpamContent = spamRegex.test(textToScan);

      const isBot = isHoneypotTriggered || isTooFast || isUnnaturalInteraction || isSpamContent;

      if (isBot) {
        // SILENT DROP: Simulate successful response to deceive the bot, but NEVER invoke Google Apps Script or Google Ads conversion
        setTimeout(() => {
          statusDiv.textContent = msgSuccess;
          statusDiv.classList.add('success');
          form.reset();
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }, 800);
        return;
      }

      // Legitimate human submission
      delete data.company_website;

      const gardenSize = (data.garden_size || data.size || '').trim();
      const extraDetails: string[] = [];
      if (data.phone) {
        extraDetails.push(`Phone: ${data.phone}`);
      }
      if (gardenSize) {
        extraDetails.push(`Garden Size: ${gardenSize}`);
      }
      if (extraDetails.length > 0) {
        data.message = `[${extraDetails.join(' | ')}]\n\n${data.message || ''}`;
      }
      if (gardenSize) {
        data.garden_size = gardenSize;
        data.size = gardenSize;
      }

      data.lang = document.documentElement.lang || "en";

      fetch("/api/leads", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ type: "contact", payload: data })
      })
      .then(async (res) => {
        const result = await res.json().catch(() => ({}));
        if (!res.ok || !result.ok) {
          throw new Error(result.error || `HTTP ${res.status}`);
        }

        statusDiv.textContent = msgSuccess;
        statusDiv.classList.remove('error');
        statusDiv.classList.add('success');

        const txId = `lead_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
        const pathname = window.location.pathname;

        // Dispara a conversão no Google Ads apenas após confirmação HTTP 200 do servidor (/api/leads)
        if (typeof window !== 'undefined' && typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'conversion', {
            'send_to': 'AW-795871100/dv-kCJrn0YoaEPyOwPsC',
            'value': 1.0,
            'currency': 'EUR',
            'transaction_id': txId
          });
          (window as any).gtag('event', 'generate_lead', {
            'currency': 'EUR',
            'value': 1.0,
            'event_label': pathname
          });
        }
        if (typeof window !== 'undefined' && Array.isArray((window as any).dataLayer)) {
          (window as any).dataLayer.push({
            event: 'generate_lead',
            page: pathname,
            transaction_id: txId
          });
        }

        form.reset();
      })
      .catch(err => {
        console.error("Transmission error:", err);
        statusDiv.textContent = msgError;
        statusDiv.classList.remove('success');
        statusDiv.classList.add('error');
      })
      .finally(() => {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      });
    });
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: relative;
  }

  .ohnohoney {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    height: 0;
    width: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .form-group {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    position: relative;
  }

  .form-group label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-limestone);
    font-weight: 500;
    transition: var(--transition-fast);
  }

  .form-group input,
  .form-group textarea {
    border: none;
    border-bottom: 1px solid var(--color-sand-dark);
    background-color: transparent;
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-charcoal);
    outline: none;
    transition: var(--transition-fast);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--color-olive);
  }

  .form-group input:focus + label,
  .form-group textarea:focus + label {
    color: var(--color-olive);
  }

  .submit-btn {
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-white);
    background-color: var(--color-charcoal);
    border: none;
    padding: 1.25rem 2.5rem;
    cursor: pointer;
    transition: var(--transition-medium);
  }

  .submit-btn:hover {
    background-color: var(--color-olive);
  }

  .form-status {
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  .form-status.success {
    color: var(--color-olive-dark);
  }

  .form-status.error {
    color: #b33939;
  }
</style>
