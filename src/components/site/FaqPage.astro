---
import Layout from '../../layouts/Layout.astro';
import { faqs } from '../../data/faq';

const pageTitle = "Frequently asked questions";
const pageSubtitle = "Everything you need to know before starting your garden — pricing, timelines, remote management, sustainability, and who's behind the studio.";
---

<Layout
  title="Frequently Asked Questions | S'Estepa Design"
  description="Answers to common questions about pricing, timelines, remote project management, sustainability, and the studio behind S'Estepa Design."
  lang="en"
  hreflangLocales={['en']}
>
  <section class="faq-section section-padding">
    <div class="container faq-container">
      <header class="page-header">
        <h1 class="page-title">{pageTitle}</h1>
        <p class="page-subtitle">{pageSubtitle}</p>
      </header>

      <div class="faq-list">
        {faqs.map((item, i) => (
          <div class="faq-item">
            <h2 class="faq-heading">
              <button
                class="faq-question"
                aria-expanded="false"
                aria-controls={`faq-answer-${i}`}
                id={`faq-question-${i}`}
              >
                <span>{item.question}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </button>
            </h2>
            <div
              class="faq-answer"
              id={`faq-answer-${i}`}
              role="region"
              aria-labelledby={`faq-question-${i}`}
            >
              <div class="faq-answer-inner">
                <p>{item.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const items = document.querySelectorAll<HTMLElement>('.faq-item');

  items.forEach((item) => {
    const button = item.querySelector<HTMLButtonElement>('.faq-question');
    if (!button) return;

    button.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      items.forEach((other) => {
        other.classList.remove('open');
        other.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
  .faq-section {
    background-color: var(--color-white);
    padding-top: 10rem;
  }

  @media (max-width: 768px) {
    .faq-section {
      padding-top: 8rem;
    }
  }

  .faq-container {
    max-width: 900px;
  }

  .page-header {
    max-width: 700px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--color-charcoal);
    margin: 0 0 1.25rem;
  }

  .page-subtitle {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-charcoal-light);
    font-weight: 300;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-sand-dark);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--color-sand-dark);
  }

  .faq-heading {
    margin: 0;
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    padding: 1.75rem 0;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-charcoal);
    transition: var(--transition-fast);
  }

  .faq-question:hover {
    color: var(--color-olive);
  }

  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: var(--color-olive);
    transition: var(--transition-fast);
  }

  .faq-icon::before {
    width: 100%;
    height: 1px;
    transform: translate(-50%, -50%);
  }

  .faq-icon::after {
    width: 1px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .faq-item.open .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq-item.open .faq-question {
    color: var(--color-olive);
  }

  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .faq-item.open .faq-answer {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
  }

  .faq-answer-inner p {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-charcoal-light);
    font-weight: 300;
    margin: 0 0 2rem;
  }

  @media (max-width: 768px) {
    .page-header {
      margin-bottom: 2.5rem;
    }

    .faq-question {
      font-size: 1.1rem;
      padding: 1.25rem 0;
      gap: 1rem;
    }

    .faq-answer-inner p {
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
