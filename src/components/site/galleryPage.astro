---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../data/translations';
import { getGalleryImages, galleryMeta } from '../../data/gallery';
import { getProjectPath } from '../../lib/urls';

interface Props {
  lang: 'en' | 'es' | 'de';
}

const { lang } = Astro.props;
const meta = galleryMeta[lang];

const images = getGalleryImages(lang).map((img) => ({
  ...img,
  projectUrl: getProjectPath(img.projectSlug, lang),
}));

// Build ordered project list preserving the exact order in `images` (which follows PORTFOLIO_PROJECT_ORDER)
interface ProjectFilterGroup {
  slug: string;
  title: string;
  count: number;
  firstSlideIndex: number;
}

const projectGroups: ProjectFilterGroup[] = [];
const projectGroupMap = new Map<string, ProjectFilterGroup>();

images.forEach((img, index) => {
  let group = projectGroupMap.get(img.projectSlug);
  if (!group) {
    group = {
      slug: img.projectSlug,
      title: img.projectTitle,
      count: 0,
      firstSlideIndex: index,
    };
    projectGroupMap.set(img.projectSlug, group);
    projectGroups.push(group);
  }
  group.count += 1;
});

const t = (key: keyof (typeof ui)[typeof lang]) => ui[lang][key] || key;

const i18n = {
  en: {
    searchPlaceholder: 'Search by garden, project or location (e.g. Sant Llorenç, Campos, Binissalem, Son Vida...)',
    clearSearch: 'Clear search',
    allProjects: 'All Projects',
    allPill: 'All',
    projectsLabel: 'Projects',
    photosWord: 'photos',
    ofWord: 'of',
    playPresentation: 'Play Presentation',
    playShort: 'PLAY',
    pauseShort: 'PAUSE',
    indexBtn: 'Index',
    lightMode: 'Light Mode',
    darkMode: 'Dark Mode',
    fullscreen: 'Fullscreen',
    exitFullscreen: 'Exit fullscreen (Esc)',
    closePresentation: 'Close presentation (Esc)',
    viewProject: 'View project',
    openSlideTitle: 'Open in fullscreen presentation',
    firstPhotoTitle: 'Jump to first photo (01)',
    lastPhotoTitle: `Jump to last photo (${images.length})`,
    noResults: 'No photographs match your search.',
    resetFilter: 'Show all photographs',
    scrollLeft: 'Scroll projects left',
    scrollRight: 'Scroll projects right',
  },
  es: {
    searchPlaceholder: 'Buscar por jardín, proyecto o ubicación (ej. Sant Llorenç, Campos, Binissalem, Son Vida...)',
    clearSearch: 'Limpiar búsqueda',
    allProjects: 'Todos los proyectos',
    allPill: 'Todos',
    projectsLabel: 'Proyectos',
    photosWord: 'fotos',
    ofWord: 'de',
    playPresentation: 'Modo Presentación',
    playShort: 'PLAY',
    pauseShort: 'PAUSA',
    indexBtn: 'Índice',
    lightMode: 'Fondo Claro',
    darkMode: 'Fondo Oscuro',
    fullscreen: 'Pantalla Completa',
    exitFullscreen: 'Salir de pantalla completa (Esc)',
    closePresentation: 'Cerrar presentación (Esc)',
    viewProject: 'Ver proyecto',
    openSlideTitle: 'Abrir en modo presentación',
    firstPhotoTitle: 'Ir a la primera foto (01)',
    lastPhotoTitle: `Ir a la última foto (${images.length})`,
    noResults: 'No se encontraron fotografías para esta búsqueda.',
    resetFilter: 'Ver todas las fotografías',
    scrollLeft: 'Desplazar proyectos a la izquierda',
    scrollRight: 'Desplazar proyectos a la derecha',
  },
  de: {
    searchPlaceholder: 'Suche nach Garten, Projekt oder Ort (z. B. Sant Llorenç, Campos, Binissalem, Son Vida...)',
    clearSearch: 'Suche löschen',
    allProjects: 'Alle Projekte',
    allPill: 'Alle',
    projectsLabel: 'Projekte',
    photosWord: 'Fotos',
    ofWord: 'von',
    playPresentation: 'Präsentation starten',
    playShort: 'PLAY',
    pauseShort: 'PAUSE',
    indexBtn: 'Index',
    lightMode: 'Heller Modus',
    darkMode: 'Dunkler Modus',
    fullscreen: 'Vollbild',
    exitFullscreen: 'Vollbild beenden (Esc)',
    closePresentation: 'Präsentation schließen (Esc)',
    viewProject: 'Projekt ansehen',
    openSlideTitle: 'In Vollbild-Präsentation öffnen',
    firstPhotoTitle: 'Zum ersten Foto (01)',
    lastPhotoTitle: `Zum letzten Foto (${images.length})`,
    noResults: 'Keine Fotos für diese Suche gefunden.',
    resetFilter: 'Alle Fotos anzeigen',
    scrollLeft: 'Projekte nach links scrollen',
    scrollRight: 'Projekte nach rechts scrollen',
  },
}[lang];
---

<Layout
  title={`S'Estepa Design | ${meta.title}`}
  description={meta.description}
  lang={lang}
>
  <article class="gallery-page section-padding">
    <div class="container">
      <header class="page-header">
        <span class="section-tag">{t('nav.gallery')}</span>
        <h1 class="page-title">{meta.title}</h1>
        <p class="page-subtitle">{meta.subtitle}</p>
        <p class="page-desc">{meta.description}</p>
      </header>

      <!-- Interactive Search, Project Selector & Presentation Toolbar -->
      <section class="gallery-toolbar" id="galleryToolbar" aria-label={meta.title}>
        <div class="gallery-toolbar-row">
          <!-- Search Bar -->
          <div class="gallery-search-wrap">
            <svg class="gallery-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5"></circle>
              <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
            </svg>
            <input
              type="search"
              id="gallerySearchInput"
              class="gallery-search-input"
              placeholder={i18n.searchPlaceholder}
              aria-label={i18n.searchPlaceholder}
              autocomplete="off"
              spellcheck="false"
            />
            <button
              type="button"
              id="gallerySearchClear"
              class="gallery-search-clear"
              style="display:none;"
              title={i18n.clearSearch}
              aria-label={i18n.clearSearch}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div class="gallery-toolbar-actions">
            <!-- Project Selector Dropdown (ordered by Projects page) -->
            <div class="project-selector-dropdown-wrap">
              <button
                type="button"
                class="btn-project-dropdown"
                id="btnProjectDropdown"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                <span id="projectDropdownCurrentLabel" class="dropdown-label-text">{i18n.projectsLabel}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>

              <div class="project-dropdown-popover" id="projectDropdownPopover" role="menu">
                <button
                  type="button"
                  class="dropdown-opt-btn active"
                  data-filter-slug="all"
                  data-filter-label={i18n.projectsLabel}
                >
                  <span>{i18n.allProjects}</span>
                </button>
                {projectGroups.map((group) => (
                  <button
                    type="button"
                    class="dropdown-opt-btn"
                    data-filter-slug={group.slug}
                    data-filter-label={group.title}
                    data-first-slide={group.firstSlideIndex}
                  >
                    <span>{group.title}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Play Presentation CTA -->
            <button
              type="button"
              class="btn-play-presentation"
              id="btnStartPresentation"
              title={i18n.playPresentation}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span class="play-btn-label-desktop">{i18n.playPresentation}</span>
              <span class="play-btn-label-mobile">{i18n.playShort}</span>
            </button>
          </div>
        </div>

        <!-- Horizontal Quick-Filter Pills Carousel (ordered by Projects page) -->
        <div class="pills-carousel-container">
          <button
            type="button"
            class="pills-arrow-btn"
            id="btnPillsPrev"
            aria-label={i18n.scrollLeft}
          >
            &#8249;
          </button>
          <div class="pills-track-mask" id="pillsTrackMask">
            <div class="index-filter-pills-row" id="indexFilterPills">
              <button
                type="button"
                class="idx-pill active"
                data-filter-slug="all"
                data-filter-label={i18n.projectsLabel}
              >
                {i18n.allPill}
              </button>
              {projectGroups.map((group) => (
                <button
                  type="button"
                  class="idx-pill"
                  data-filter-slug={group.slug}
                  data-filter-label={group.title}
                  data-first-slide={group.firstSlideIndex}
                >
                  {group.title}
                </button>
              ))}
            </div>
          </div>
          <button
            type="button"
            class="pills-arrow-btn"
            id="btnPillsNext"
            aria-label={i18n.scrollRight}
          >
            &#8250;
          </button>
        </div>
      </section>

      <!-- Overview Grid View -->
      <div class="gallery-overview-grid" id="overviewGrid">
        {images.map((img, idx) => {
          const numStr = String(idx + 1).padStart(2, '0');
          return (
            <article
              class="overview-card"
              data-index={idx}
              data-slug={img.projectSlug}
              data-title={img.projectTitle}
              data-search={img.searchKeywords}
            >
              <button
                type="button"
                class="overview-thumb-btn"
                data-open-slide={idx}
                aria-label={`${numStr}. ${img.projectTitle} — ${i18n.openSlideTitle}`}
              >
                <img
                  src={encodeURI(img.src)}
                  alt={img.alt}
                  loading={idx < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="overview-thumb"
                />
                <span class="overview-zoom-badge" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="21" y1="3" x2="14" y2="10"></line>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                  </svg>
                </span>
              </button>
              <div class="overview-card-footer">
                <button
                  type="button"
                  class="overview-caption-btn"
                  data-open-slide={idx}
                >
                  <span class="overview-num">{numStr}.</span>
                  <span class="overview-title">{img.projectTitle}</span>
                </button>
                <a
                  href={img.projectUrl}
                  class="overview-project-link"
                  title={`${i18n.viewProject}: ${img.projectTitle}`}
                >
                  <span>{i18n.viewProject}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Empty Search State -->
      <div class="gallery-empty-state" id="galleryEmptyState" style="display:none;">
        <p class="empty-state-text">{i18n.noResults}</p>
        <button type="button" class="btn-reset-filter" id="btnResetGalleryFilter">
          {i18n.resetFilter}
        </button>
      </div>
    </div>
  </article>

  <!-- ==========================================================================
       IMMERSIVE PRESENTATION & SLIDESHOW OVERLAY (DUAL-BUFFER GPU SAFE FOR IOS)
       ========================================================================== -->
  <div
    class="pres-overlay"
    id="presentationOverlay"
    aria-hidden="true"
    role="dialog"
    aria-label={meta.title}
  >
    <!-- Persistent Top Bar inside Presentation -->
    <header class="pres-top-bar" id="presTopBar">
      <nav class="pres-brand-nav" aria-label="Presentation Navigation">
        <a href={lang === 'en' ? '/' : `/${lang}/`} class="pres-brand-link">
          <span class="brand-name-full">S'Estepa Design Studio</span>
          <span class="brand-name-short">S'Estepa</span>
        </a>
        <span class="pres-brand-sep">|</span>
        <button type="button" class="pres-brand-link pres-brand-btn" id="presBrandIndexBtn">
          <span>{t('nav.gallery')}</span>
        </button>
        <span class="pres-brand-sep pres-brand-loc-sep">|</span>
        <span class="pres-brand-location">Mallorca</span>
      </nav>

      <div class="pres-top-controls">
        <!-- 1. Return to Index Grid (G) -->
        <button type="button" class="pres-btn-icon" id="btnPresOverview" title={`${i18n.indexBtn} (G)`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span class="pres-btn-label">{i18n.indexBtn}</span>
        </button>

        <!-- 2. PLAY / PAUSE Video Slideshow (Space) -->
        <button type="button" class="pres-btn-icon" id="btnPresAutoPlay" title="Play / Pause (Space)">
          <svg id="presPlayIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span id="presAutoPlayText" class="pres-btn-label">{i18n.playShort}</span>
        </button>

        <!-- 3. Theme Toggle (Light Mediterranean Sand / Dark Cinema) -->
        <button type="button" class="pres-btn-icon" id="btnPresThemeToggle" title={i18n.lightMode}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span id="presThemeToggleText" class="pres-btn-label pres-hide-mobile">{i18n.lightMode}</span>
        </button>

        <!-- 4. Native Fullscreen Toggle (F) -->
        <button type="button" class="pres-btn-icon" id="btnPresFullscreen" title={`${i18n.fullscreen} (F)`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span class="pres-btn-label pres-hide-mobile">{i18n.fullscreen}</span>
        </button>

        <!-- 5. Close Presentation (Esc) -->
        <button
          type="button"
          class="pres-btn-close"
          id="btnPresClose"
          title={i18n.closePresentation}
          aria-label={i18n.closePresentation}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Floating Exit Fullscreen Button (Visible when in 100% Pure Fullscreen) -->
    <button
      type="button"
      class="pres-fs-close-btn"
      id="btnExitFs"
      title={i18n.exitFullscreen}
      aria-label={i18n.exitFullscreen}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Dual-Buffer Slideshow Stage (Only 2 DOM slides instead of 96 to prevent iOS Safari GPU crashes) -->
    <div class="pres-deck-container" id="deckContainer">
      <section class="pres-slide active" id="presSlideA">
        <div class="pres-slide-figure">
          <div class="pres-image-wrapper">
            <img src="" alt="" decoding="async" class="pres-slide-img" id="presImgA" />
          </div>
        </div>
      </section>
      <section class="pres-slide" id="presSlideB">
        <div class="pres-slide-figure">
          <div class="pres-image-wrapper">
            <img src="" alt="" decoding="async" class="pres-slide-img" id="presImgB" />
          </div>
        </div>
      </section>
    </div>

    <!-- Bottom Navigation Bar & Interactive Filmstrip Drawer -->
    <footer class="pres-bottom-bar" id="presBottomBar">
      <div class="pres-bottom-bar-content">
        <div class="pres-bottom-project-info" id="bottomProjectPill">
          <a
            href={images[0]?.projectUrl || '#'}
            class="pres-bottom-project-name"
            id="bottomProjectName"
            title={i18n.viewProject}
          >
            {images[0]?.projectTitle || ''}
          </a>
          <span class="pres-bottom-counter" id="bottomCounter">
            <button
              type="button"
              class="counter-num counter-current"
              id="counterCurrent"
              title={i18n.firstPhotoTitle}
            >
              01
            </button>
            <span class="counter-sep">/</span>
            <button
              type="button"
              class="counter-num counter-total"
              id="counterTotal"
              title={i18n.lastPhotoTitle}
            >
              {String(images.length).padStart(2, '0')}
            </button>
          </span>
        </div>

        <!-- Luxury Interactive Filmstrip Carousel (Hydrated on-demand when revealed) -->
        <div class="pres-bottom-filmstrip-drawer" id="bottomFilmstripDrawer">
          <div class="filmstrip-scroll-mask" id="filmstripScrollMask">
            <div class="filmstrip-track" id="filmstripTrack">
              {images.map((img, idx) => (
                <button
                  type="button"
                  class={`filmstrip-thumb-btn${idx === 0 ? ' active' : ''}`}
                  data-index={idx}
                  data-thumb-src={encodeURI(img.src)}
                  aria-label={`${img.projectTitle} (${idx + 1})`}
                  title={`${idx + 1}. ${img.projectTitle}`}
                >
                  <img
                    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                    alt={img.alt}
                    loading="lazy"
                    decoding="async"
                    class="filmstrip-thumb-img"
                  />
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<script define:vars={{ images, i18n }}>
(() => {
  // Normalize strings (strip accents/diacritics and lowercase)
  function normalizeStr(str) {
    return (str || '')
      .toString()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  // DOM Elements - Index / Overview
  const searchInput = document.getElementById('gallerySearchInput');
  const searchClear = document.getElementById('gallerySearchClear');
  const btnProjectDropdown = document.getElementById('btnProjectDropdown');
  const projectDropdownPopover = document.getElementById('projectDropdownPopover');
  const projectDropdownCurrentLabel = document.getElementById('projectDropdownCurrentLabel');
  const dropdownOptBtns = document.querySelectorAll('.dropdown-opt-btn');
  const pillBtns = document.querySelectorAll('.idx-pill');
  const pillsTrackMask = document.getElementById('pillsTrackMask');
  const btnPillsPrev = document.getElementById('btnPillsPrev');
  const btnPillsNext = document.getElementById('btnPillsNext');
  const overviewCards = document.querySelectorAll('.overview-card');
  const emptyState = document.getElementById('galleryEmptyState');
  const btnResetGalleryFilter = document.getElementById('btnResetGalleryFilter');
  const btnStartPresentation = document.getElementById('btnStartPresentation');

  // DOM Elements - Presentation Overlay (Dual-Buffer Stage)
  const presOverlay = document.getElementById('presentationOverlay');
  const deckContainer = document.getElementById('deckContainer');
  const slideBuffers = [
    { slide: document.getElementById('presSlideA'), img: document.getElementById('presImgA') },
    { slide: document.getElementById('presSlideB'), img: document.getElementById('presImgB') },
  ];
  let activeBufferIdx = 0;

  const totalSlides = images.length;
  const bottomProjectName = document.getElementById('bottomProjectName');
  const counterCurrent = document.getElementById('counterCurrent');
  const counterTotal = document.getElementById('counterTotal');
  const filmstripThumbs = document.querySelectorAll('.filmstrip-thumb-btn');
  const bottomFilmstripDrawer = document.getElementById('bottomFilmstripDrawer');
  const bottomProjectPill = document.getElementById('bottomProjectPill');

  const btnPresOverview = document.getElementById('btnPresOverview');
  const presBrandIndexBtn = document.getElementById('presBrandIndexBtn');
  const btnPresAutoPlay = document.getElementById('btnPresAutoPlay');
  const presAutoPlayText = document.getElementById('presAutoPlayText');
  const presPlayIcon = document.getElementById('presPlayIcon');
  const btnPresThemeToggle = document.getElementById('btnPresThemeToggle');
  const presThemeToggleText = document.getElementById('presThemeToggleText');
  const btnPresFullscreen = document.getElementById('btnPresFullscreen');
  const btnPresClose = document.getElementById('btnPresClose');
  const btnExitFs = document.getElementById('btnExitFs');

  if (!presOverlay || !deckContainer) return;

  // Hydrate filmstrip thumbnails only when needed (protects iOS Safari memory)
  let filmstripHydrated = false;
  function hydrateFilmstrip() {
    if (filmstripHydrated) return;
    filmstripHydrated = true;
    filmstripThumbs.forEach((btn) => {
      const thumbSrc = btn.getAttribute('data-thumb-src');
      const imgEl = btn.querySelector('img');
      if (thumbSrc && imgEl) {
        imgEl.src = thumbSrc;
      }
    });
  }

  // Filter State
  let firstVisibleSlideIndex = 0;

  function applyGalleryFilter({ slug = 'all', query = '', label = '' }) {
    const normQuery = normalizeStr(query);
    let visibleCount = 0;
    firstVisibleSlideIndex = -1;

    if (searchClear) {
      searchClear.style.display = normQuery || slug !== 'all' ? 'flex' : 'none';
    }

    // Update pills active state
    pillBtns.forEach((pill) => {
      const pillSlug = pill.getAttribute('data-filter-slug') || 'all';
      const isMatch =
        (slug !== 'all' && pillSlug === slug) ||
        (slug === 'all' && !normQuery && pillSlug === 'all');
      pill.classList.toggle('active', isMatch);
    });

    // Update dropdown options active state
    dropdownOptBtns.forEach((opt) => {
      const optSlug = opt.getAttribute('data-filter-slug') || 'all';
      const isMatch =
        (slug !== 'all' && optSlug === slug) ||
        (slug === 'all' && !normQuery && optSlug === 'all');
      opt.classList.toggle('active', isMatch);
    });

    // Update dropdown button text
    if (projectDropdownCurrentLabel) {
      if (slug !== 'all' && label) {
        projectDropdownCurrentLabel.textContent = label;
      } else if (normQuery) {
        projectDropdownCurrentLabel.textContent = query;
      } else {
        projectDropdownCurrentLabel.textContent = i18n.projectsLabel;
      }
    }

    // Filter cards
    overviewCards.forEach((card) => {
      const cardIdx = Number(card.getAttribute('data-index') || 0);
      const cardSlug = card.getAttribute('data-slug') || '';
      const cardSearch = normalizeStr(card.getAttribute('data-search') || '');

      let match = true;
      if (slug !== 'all') {
        match = cardSlug === slug;
      } else if (normQuery) {
        match = cardSearch.includes(normQuery);
      }

      card.style.display = match ? 'flex' : 'none';
      if (match) {
        if (firstVisibleSlideIndex === -1) firstVisibleSlideIndex = cardIdx;
        visibleCount++;
      }
    });

    if (firstVisibleSlideIndex === -1) firstVisibleSlideIndex = 0;

    // Empty state visibility
    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
    }
  }

  // Search Input Handler
  searchInput?.addEventListener('input', (e) => {
    const val = e.target.value || '';
    applyGalleryFilter({ slug: 'all', query: val });
  });

  // Clear Button Handler
  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    applyGalleryFilter({ slug: 'all', query: '' });
    searchInput?.focus();
  });

  btnResetGalleryFilter?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    applyGalleryFilter({ slug: 'all', query: '' });
  });

  // Pills Click Handler
  pillBtns.forEach((pill) => {
    pill.addEventListener('click', () => {
      const slug = pill.getAttribute('data-filter-slug') || 'all';
      const label = pill.getAttribute('data-filter-label') || '';
      if (searchInput) searchInput.value = slug === 'all' ? '' : label;
      applyGalleryFilter({ slug, query: '', label });
      pill.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    });
  });

  // Dropdown Toggle & Option Click
  btnProjectDropdown?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = projectDropdownPopover?.classList.toggle('open');
    btnProjectDropdown.classList.toggle('active', Boolean(isOpen));
    btnProjectDropdown.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.project-selector-dropdown-wrap')) {
      projectDropdownPopover?.classList.remove('open');
      btnProjectDropdown?.classList.remove('active');
      btnProjectDropdown?.setAttribute('aria-expanded', 'false');
    }
  });

  dropdownOptBtns.forEach((opt) => {
    opt.addEventListener('click', () => {
      const slug = opt.getAttribute('data-filter-slug') || 'all';
      const label = opt.getAttribute('data-filter-label') || '';
      projectDropdownPopover?.classList.remove('open');
      btnProjectDropdown?.classList.remove('active');
      btnProjectDropdown?.setAttribute('aria-expanded', 'false');
      if (searchInput) searchInput.value = slug === 'all' ? '' : label;
      applyGalleryFilter({ slug, query: '', label });
    });
  });

  // Pills Horizontal Carousel Arrows
  btnPillsPrev?.addEventListener('click', () => {
    pillsTrackMask?.scrollBy({ left: -240, behavior: 'smooth' });
  });
  btnPillsNext?.addEventListener('click', () => {
    pillsTrackMask?.scrollBy({ left: 240, behavior: 'smooth' });
  });

  // =========================================================================
  // PRESENTATION SLIDESHOW ENGINE (DUAL-BUFFER, MEMORY-SAFE)
  // =========================================================================
  let currentSlide = 0;
  let isPlaying = false;
  let autoPlayTimer = null;
  let autoResumeTimer = null;
  let idleTimer = null;
  let outgoingTimeout = null;
  const SLIDE_DURATION = 4200;
  const AUTO_RESUME_DELAY = 20000;
  const preloader = new Image();

  function isPresentationActive() {
    return presOverlay.classList.contains('active');
  }

  function goToSlide(index, animate = true) {
    if (index < 0 || index >= totalSlides) return;
    const item = images[index];
    if (!item) return;

    const encodedSrc = encodeURI(item.src);

    if (!animate) {
      const currentBuf = slideBuffers[activeBufferIdx];
      const otherBuf = slideBuffers[1 - activeBufferIdx];
      otherBuf.slide?.classList.remove('active', 'outgoing');
      if (currentBuf.img) {
        currentBuf.img.src = encodedSrc;
        currentBuf.img.alt = item.alt;
      }
      currentBuf.slide?.classList.remove('outgoing');
      currentBuf.slide?.classList.add('active');
    } else if (index !== currentSlide) {
      const prevBuf = slideBuffers[activeBufferIdx];
      activeBufferIdx = 1 - activeBufferIdx;
      const nextBuf = slideBuffers[activeBufferIdx];

      clearTimeout(outgoingTimeout);
      if (nextBuf.img) {
        nextBuf.img.src = encodedSrc;
        nextBuf.img.alt = item.alt;
      }

      prevBuf.slide?.classList.remove('active');
      prevBuf.slide?.classList.add('outgoing');
      nextBuf.slide?.classList.remove('outgoing');
      nextBuf.slide?.classList.add('active');

      outgoingTimeout = setTimeout(() => {
        prevBuf.slide?.classList.remove('outgoing');
      }, 900);
    }

    currentSlide = index;

    if (bottomProjectName) {
      bottomProjectName.textContent = item.projectTitle;
      bottomProjectName.href = item.projectUrl || '#';
    }
    if (counterCurrent) {
      counterCurrent.textContent = String(currentSlide + 1).padStart(2, '0');
    }
    if (counterTotal) {
      counterTotal.textContent = String(totalSlides).padStart(2, '0');
    }

    // Sync active filmstrip thumbnail & center scroll if filmstrip is hydrated
    filmstripThumbs.forEach((btn, i) => {
      if (i === currentSlide) {
        btn.classList.add('active');
        if (filmstripHydrated) {
          btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      } else {
        btn.classList.remove('active');
      }
    });

    // Preload only the single next slide image
    const nextIdx = (currentSlide + 1) % totalSlides;
    if (images[nextIdx]) {
      preloader.src = encodeURI(images[nextIdx].src);
    }
  }

  function nextSlide() {
    goToSlide(currentSlide < totalSlides - 1 ? currentSlide + 1 : 0, true);
  }

  function prevSlide() {
    goToSlide(currentSlide > 0 ? currentSlide - 1 : totalSlides - 1, true);
  }

  function openPresentation(index, startPlay = false) {
    presOverlay.classList.add('is-mounted');
    goToSlide(typeof index === 'number' ? index : 0, false);

    requestAnimationFrame(() => {
      presOverlay.classList.add('active');
      presOverlay.setAttribute('aria-hidden', 'false');
    });
    document.body.style.overflow = 'hidden';

    if (startPlay) {
      startAutoPlay();
    } else {
      scheduleAutoResume();
    }
  }

  function closePresentation() {
    stopAutoPlay(true);
    cancelAutoResume();
    clearTimeout(idleTimer);
    if (document.fullscreenElement || document.webkitFullscreenElement) {
      if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
    }
    presOverlay.classList.remove('active', 'is-fullscreen', 'hide-controls');
    presOverlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (!presOverlay.classList.contains('active')) {
        presOverlay.classList.remove('is-mounted');
      }
    }, 450);
  }

  // Idle auto-hide in fullscreen (900ms) -> 100% pure landscape photo
  function resetIdleTimer() {
    presOverlay.classList.remove('hide-controls');
    clearTimeout(idleTimer);
    if (
      presOverlay.classList.contains('is-fullscreen') ||
      document.fullscreenElement ||
      document.webkitFullscreenElement
    ) {
      idleTimer = setTimeout(() => {
        presOverlay.classList.add('hide-controls');
      }, 900);
    }
  }

  function scheduleAutoResume() {
    clearTimeout(autoResumeTimer);
    if (isPresentationActive() && !isPlaying) {
      autoResumeTimer = setTimeout(() => {
        if (isPresentationActive() && !isPlaying) {
          startAutoPlay();
        }
      }, AUTO_RESUME_DELAY);
    }
  }

  function cancelAutoResume() {
    clearTimeout(autoResumeTimer);
  }

  function startAutoPlay() {
    cancelAutoResume();
    isPlaying = true;
    if (!isPresentationActive()) {
      openPresentation(firstVisibleSlideIndex, false);
    }
    enterFullscreen();
    btnPresAutoPlay?.classList.add('active-mode');
    if (presAutoPlayText) presAutoPlayText.textContent = i18n.pauseShort;
    if (presPlayIcon) {
      presPlayIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>';
    }
    clearInterval(autoPlayTimer);
    autoPlayTimer = setInterval(nextSlide, SLIDE_DURATION);
  }

  function stopAutoPlay(preventResume = false) {
    isPlaying = false;
    btnPresAutoPlay?.classList.remove('active-mode');
    if (presAutoPlayText) presAutoPlayText.textContent = i18n.playShort;
    if (presPlayIcon) {
      presPlayIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"></polygon>';
    }
    clearInterval(autoPlayTimer);
    if (!preventResume) {
      scheduleAutoResume();
    } else {
      cancelAutoResume();
    }
  }

  function toggleAutoPlay() {
    if (isPlaying) {
      stopAutoPlay();
    } else {
      startAutoPlay();
    }
  }

  // Fullscreen helpers
  function enterFullscreen() {
    const docEl = document.documentElement;
    if (!document.fullscreenElement && !document.webkitFullscreenElement) {
      if (docEl.requestFullscreen) docEl.requestFullscreen().catch(() => {});
      else if (docEl.webkitRequestFullscreen) docEl.webkitRequestFullscreen();
    }
    presOverlay.classList.add('is-fullscreen');
    resetIdleTimer();
  }

  function exitFullscreenMode() {
    if (document.fullscreenElement || document.webkitFullscreenElement) {
      if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
    }
    presOverlay.classList.remove('is-fullscreen', 'hide-controls');
    stopAutoPlay();
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement && !document.webkitFullscreenElement && !presOverlay.classList.contains('is-fullscreen')) {
      enterFullscreen();
    } else {
      exitFullscreenMode();
    }
  }

  document.addEventListener('fullscreenchange', () => {
    if (document.fullscreenElement || document.webkitFullscreenElement) {
      presOverlay.classList.add('is-fullscreen');
      resetIdleTimer();
    } else {
      presOverlay.classList.remove('is-fullscreen', 'hide-controls');
      stopAutoPlay();
    }
  });

  // Wire Overview Card clicks to open Presentation at that slide
  document.querySelectorAll('[data-open-slide]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-open-slide') || 0);
      openPresentation(idx, false);
    });
  });

  // Wire Toolbar Play Presentation button
  btnStartPresentation?.addEventListener('click', () => {
    openPresentation(firstVisibleSlideIndex, true);
  });

  // Wire Presentation Top Bar Controls
  btnPresOverview?.addEventListener('click', closePresentation);
  presBrandIndexBtn?.addEventListener('click', closePresentation);
  btnPresClose?.addEventListener('click', closePresentation);
  btnExitFs?.addEventListener('click', exitFullscreenMode);
  btnPresAutoPlay?.addEventListener('click', toggleAutoPlay);
  btnPresFullscreen?.addEventListener('click', toggleFullscreen);

  // Theme Toggle inside Presentation (Dark Cinema vs Mediterranean Sand Light)
  btnPresThemeToggle?.addEventListener('click', () => {
    const isLight = presOverlay.classList.toggle('pres-light');
    if (presThemeToggleText) {
      presThemeToggleText.textContent = isLight ? i18n.darkMode : i18n.lightMode;
    }
  });

  // Filmstrip Thumbnail Clicks
  filmstripThumbs.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      stopAutoPlay();
      const idx = Number(btn.getAttribute('data-index') || 0);
      goToSlide(idx, true);
    });
  });

  // Counter Jump to First / Last Photo
  counterCurrent?.addEventListener('click', (e) => {
    e.stopPropagation();
    stopAutoPlay();
    goToSlide(0, true);
  });

  counterTotal?.addEventListener('click', (e) => {
    e.stopPropagation();
    stopAutoPlay();
    goToSlide(totalSlides - 1, true);
  });

  // Directional Cursor & Half-Screen Click Navigation
  deckContainer.addEventListener('mousemove', (e) => {
    const width = window.innerWidth;
    if (e.clientX < width / 2) {
      deckContainer.classList.add('cursor-prev');
      deckContainer.classList.remove('cursor-next');
    } else {
      deckContainer.classList.add('cursor-next');
      deckContainer.classList.remove('cursor-prev');
    }
  });

  deckContainer.addEventListener('click', (e) => {
    if (!isPresentationActive()) return;
    stopAutoPlay();
    const width = window.innerWidth;
    if (e.clientX < width / 2) {
      prevSlide();
    } else {
      nextSlide();
    }
  });

  // Reveal Filmstrip when mouse approaches bottom 130px
  presOverlay.addEventListener('mousemove', (e) => {
    if (!isPresentationActive()) return;
    resetIdleTimer();
    scheduleAutoResume();
    const distFromBottom = window.innerHeight - e.clientY;
    if (distFromBottom < 130) {
      hydrateFilmstrip();
      bottomFilmstripDrawer?.classList.add('is-revealed');
    } else if (!e.target.closest('#bottomFilmstripDrawer')) {
      bottomFilmstripDrawer?.classList.remove('is-revealed');
    }
  });

  // On touch devices: tapping bottom pill toggles filmstrip
  bottomProjectPill?.addEventListener('click', (e) => {
    if (!e.target.closest('a') && !e.target.closest('button')) {
      e.stopPropagation();
      hydrateFilmstrip();
      bottomFilmstripDrawer?.classList.toggle('is-revealed');
    }
  });

  // Touch Swipe Navigation in Presentation
  let touchStartX = 0;
  let touchStartY = 0;
  let touchStartTime = 0;

  presOverlay.addEventListener('touchstart', (e) => {
    if (!isPresentationActive()) return;
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
    touchStartTime = Date.now();
    resetIdleTimer();
    scheduleAutoResume();
  }, { passive: true });

  presOverlay.addEventListener('touchend', (e) => {
    if (!isPresentationActive()) return;
    if (
      e.target.closest('button') ||
      e.target.closest('a') ||
      e.target.closest('.pres-top-bar') ||
      e.target.closest('.pres-bottom-bar') ||
      e.target.closest('.pres-fs-close-btn')
    ) {
      return;
    }

    const diffX = e.changedTouches[0].screenX - touchStartX;
    const diffY = e.changedTouches[0].screenY - touchStartY;
    const elapsed = Date.now() - touchStartTime;

    if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
      stopAutoPlay();
      if (diffX < 0) nextSlide();
      else prevSlide();
      return;
    }

    if (Math.abs(diffX) < 20 && Math.abs(diffY) < 20 && elapsed < 400) {
      if (isPlaying) {
        stopAutoPlay();
        return;
      }
      const width = window.innerWidth;
      const tapX = e.changedTouches[0].clientX;
      if (tapX < width / 2) prevSlide();
      else nextSlide();
    }
  }, { passive: true });

  // Keyboard Shortcuts in Presentation
  window.addEventListener('keydown', (e) => {
    if (!isPresentationActive()) return;
    resetIdleTimer();

    switch (e.key) {
      case 'ArrowRight':
      case 'ArrowDown':
      case 'PageDown':
        e.preventDefault();
        stopAutoPlay();
        nextSlide();
        break;
      case 'ArrowLeft':
      case 'ArrowUp':
      case 'Backspace':
      case 'PageUp':
        e.preventDefault();
        stopAutoPlay();
        prevSlide();
        break;
      case ' ':
        e.preventDefault();
        toggleAutoPlay();
        break;
      case 'Home':
        e.preventDefault();
        stopAutoPlay();
        goToSlide(0, true);
        break;
      case 'End':
        e.preventDefault();
        stopAutoPlay();
        goToSlide(totalSlides - 1, true);
        break;
      case 'g':
      case 'G':
        e.preventDefault();
        closePresentation();
        break;
      case 'f':
      case 'F':
        e.preventDefault();
        toggleFullscreen();
        break;
      case 'Escape':
        e.preventDefault();
        if (document.fullscreenElement || document.webkitFullscreenElement || presOverlay.classList.contains('is-fullscreen')) {
          exitFullscreenMode();
        } else {
          closePresentation();
        }
        break;
    }
  });
})();
</script>

