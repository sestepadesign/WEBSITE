---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { projects, getProjectLocation } from '../../data/projects';
import { getPagePath, getProjectPath } from '../../lib/urls';

interface Props { lang: 'en' | 'es' | 'de'; }
const { lang } = Astro.props;

const blogMeta = {
  en: {
    eyebrow: "The S'Estepa Journal",
    title: 'Garden Design Insights in Mallorca',
    subtitle: 'Boutique garden design and landscape architecture studio',
    taglineItalic: 'Three decades devoted to crafting exclusive fincas and Mediterranean landscapes.',
    description:
      "Notes on Mediterranean garden design, drought-resilient planting and outdoor living in Mallorca, drawn from the projects of S'Estepa Design.",
    viewGarden: 'View this garden',
    worksTag: 'Selected Work',
    heroPanelTag: 'Landscape Design',
    worksTitle: 'A Portfolio of Mediterranean Gardens',
    worksDesc:
      'Gardens designed, built and cared for across the island by our own team — from hillside fincas to sea-facing terraces.',
    worksCta: 'Explore the full portfolio',
    filmTag: 'Gardens in Motion',
    filmTitle: 'On Film',
    filmDesc: 'Short films following how each landscape settles into its site through the seasons.',
    shortsTitle: 'In Short',
    shortsDesc: 'Vertical clips from recent gardens.',
    playLabel: 'Play film',
    journalTag: 'The Journal',
    journalTitle: 'Start Here',
    journalDesc:
      'The articles most read before commissioning a garden — planning, shelter, water, and long-term property value.',
    readArticle: 'Read article',
    ctaTitle: 'Planning a garden in Mallorca?',
    ctaDesc: 'Tell us about your finca, villa or terrace. We work in English, Spanish and German.',
    ctaButton: 'Request a consultation',
    carouselLabel: 'Garden portfolio carousel',
  },
  es: {
    eyebrow: "El Diario de S'Estepa",
    title: 'Diseño de Jardines en Mallorca: Perspectivas',
    subtitle: 'Estudio boutique de diseño de jardines y arquitectura del paisaje',
    taglineItalic: 'Tres décadas dedicadas a crear fincas exclusivas y paisajes mediterráneos.',
    description:
      "Notas sobre diseño de jardines mediterráneos, plantación resistente a la sequía y vida al aire libre en Mallorca, a partir de los proyectos de S'Estepa Design.",
    viewGarden: 'Ver este jardín',
    worksTag: 'Trabajo Seleccionado',
    heroPanelTag: 'Diseño de Paisaje',
    worksTitle: 'Un Portfolio de Jardines Mediterráneos',
    worksDesc:
      'Jardines diseñados, construidos y cuidados por toda la isla por nuestro propio equipo — de fincas en ladera a terrazas frente al mar.',
    worksCta: 'Explorar el portfolio completo',
    filmTag: 'Jardines en Movimiento',
    filmTitle: 'En Vídeo',
    filmDesc: 'Cortos que siguen cómo cada paisaje se asienta en su entorno a lo largo de las estaciones.',
    shortsTitle: 'En Corto',
    shortsDesc: 'Clips verticales de jardines recientes.',
    playLabel: 'Ver vídeo',
    journalTag: 'El Diario',
    journalTitle: 'Empiece Aquí',
    journalDesc:
      'Los artículos más leídos antes de encargar un jardín — planificación, abrigo, agua y valor patrimonial a largo plazo.',
    readArticle: 'Leer artículo',
    ctaTitle: '¿Planea un jardín en Mallorca?',
    ctaDesc: 'Cuéntenos sobre su finca, villa o terraza. Trabajamos en español, inglés y alemán.',
    ctaButton: 'Solicitar una consulta',
    carouselLabel: 'Carrusel del portfolio de jardines',
  },
  de: {
    eyebrow: "Das S'Estepa Journal",
    title: 'Gartendesign auf Mallorca: Einblicke',
    subtitle: 'Boutique-Studio für Gartendesign und Landschaftsarchitektur',
    taglineItalic: 'Drei Jahrzehnte für exklusive Fincas und mediterrane Landschaften.',
    description:
      "Notizen zu mediterranem Gartendesign, trockenheitsresistenter Bepflanzung und Outdoor-Living auf Mallorca, aus den Projekten von S'Estepa Design.",
    viewGarden: 'Diesen Garten ansehen',
    worksTag: 'Ausgewählte Arbeiten',
    heroPanelTag: 'Landschaftsarchitektur',
    worksTitle: 'Ein Portfolio Mediterraner Gärten',
    worksDesc:
      'Gärten, die unser Team auf der ganzen Insel entwirft, baut und pflegt — von Hangfincas bis zu Terrassen am Meer.',
    worksCta: 'Das vollständige Portfolio ansehen',
    filmTag: 'Gärten in Bewegung',
    filmTitle: 'Im Film',
    filmDesc: 'Kurzfilme darüber, wie sich jede Landschaft im Lauf der Jahreszeiten in ihren Ort einfügt.',
    shortsTitle: 'Kurz Gefilmt',
    shortsDesc: 'Vertikale Clips aus aktuellen Gärten.',
    playLabel: 'Film abspielen',
    journalTag: 'Das Journal',
    journalTitle: 'Hier Beginnen',
    journalDesc:
      'Die meistgelesenen Artikel vor einer Gartenbeauftragung — Planung, Schutz, Wasser und langfristiger Immobilienwert.',
    readArticle: 'Artikel lesen',
    ctaTitle: 'Planen Sie einen Garten auf Mallorca?',
    ctaDesc: 'Erzählen Sie uns von Ihrer Finca, Villa oder Terrasse. Wir arbeiten auf Deutsch, Englisch und Spanisch.',
    ctaButton: 'Beratung anfragen',
    carouselLabel: 'Karussell des Gartenportfolios',
  },
};
const meta = blogMeta[lang];

const whatsappTexts = {
  en: "Hello S'Estepa Design! I read your journal and would like to request a consultation.",
  es: "Hola S'Estepa Design! He leído su diario y me gustaría solicitar una consulta.",
  de: "Hallo S'Estepa Design! Ich habe Ihr Journal gelesen und möchte eine Beratung anfragen.",
};
const whatsappUrl = `https://wa.me/34681272252?text=${encodeURIComponent(whatsappTexts[lang])}`;

// Pre-generated mobile cover variants (shared with the Home featured grid).
const coverSrcsets: Record<string, string> = {
  'sant-llorenc':
    '/portfolio/sant-llorenc/images/garden-design-mallorca-sestepa-landscape-design-sant-llorenc-18-card.webp',
  'finca-garden-campos-mallorca':
    '/portfolio/finca-garden-campos-mallorca/garden-design-mallorca-finca-garden-campos-mallorca-sestepa-card.webp',
  'crestatx-garden-design':
    '/portfolio/crestatx-garden-design/garden-design-mallorca-crestatx-garden-design-sestepa-card.webp',
  'garden-design-llubi-mallorca':
    '/portfolio/garden-design-llubi-mallorca/images/landscape-architecture-mallorca-llubi-sestepa-design%20(1)-card.webp',
  'terrace-garden-in-palma':
    '/portfolio/terrace-garden-in-palma/garden-design-mallorca-terrace-garden-in-palma-sestepa-card.webp',
  'santa-ponsa': '/portfolio/santa-ponsa/images/GARDEN-DESIGN-MALLORCA-SANTA-PONSA-SESTEPA-1-card.webp',
  binissalem: '/portfolio/binissalem/garden-design-mallorca-binissalem-sestepa-card.webp',
  'terrace-garden-santa-eugenia':
    '/portfolio/terrace-garden-santa-eugenia/images/garden-design-mallorca-santa-eugenia-sestepa-card.webp',
};

type Garden = {
  slug: string;
  title: string;
  subtitle: string;
  descIntro: string;
  category: string;
  location: string;
  year: string;
  size?: string;
  cover: string;
  coverSrcset?: string;
  href: string;
};
function garden(slug: string): Garden | null {
  const p = projects.find((x) => x.slug === slug);
  if (!p) return null;
  const firstPara = (p[lang].description?.[0] ?? '').replace(/<[^>]+>/g, '').trim();
  return {
    slug,
    title: p[lang].title,
    subtitle: p[lang].subtitle,
    descIntro: firstPara,
    category: p[lang].category,
    location: getProjectLocation(p, lang),
    year: p.year,
    size: p.size,
    cover: p.cover,
    coverSrcset: coverSrcsets[slug],
    href: getProjectPath(slug, lang),
  };
}

const heroSlides = [
  'sant-llorenc',
  'finca-garden-campos-mallorca',
  'garden-design-llubi-mallorca',
  'crestatx-garden-design',
  'vertical-gardens-in-mallorca',
]
  .map(garden)
  .filter((g): g is Garden => Boolean(g));

const stripGardens = [
  'sant-llorenc',
  'finca-garden-campos-mallorca',
  'garden-design-llubi-mallorca',
  'terrace-garden-santa-eugenia',
  'crestatx-garden-design',
  'binissalem',
  'terrace-garden-in-palma',
  'santa-ponsa',
  'vertical-gardens-in-mallorca',
]
  .map(garden)
  .filter((g): g is Garden => Boolean(g));

const films = [
  { slug: 'finca-garden-campos-mallorca', ytId: 'McyZviXDxhc' },
  { slug: 'crestatx-garden-design', ytId: '-xs_kKaUnGA' },
  { slug: 'jardin-mediterraneo', ytId: 'Aynezzlact0' },
  { slug: 'jardin-mediterraneo', ytId: 'IdGlxUKjhUQ' },
  { slug: 'vertical-gardens-in-mallorca', ytId: 'x3W0KQmr-pQ' },
  { slug: 'finca-garden-campos-mallorca', ytId: 'g6QG3idswLU', name: 'Garden Film', loc: 'Mallorca' },
]
  .map((f) => {
    const g = garden(f.slug);
    if (!g) return null;
    return { ...g, ytId: f.ytId, title: f.name ?? g.title, location: f.loc ?? g.location };
  })
  .filter((f): f is Garden & { ytId: string } => Boolean(f));

// Vertical Shorts (9:16). Row is built for up to 4 across.
const shorts = [
  { slug: undefined as string | undefined, ytId: 'aukR9zbC9og', label: "S'Estepa Design · Mallorca" },
  { slug: undefined as string | undefined, ytId: 'jXku-VCfZ94', label: "S'Estepa Design · Mallorca" },
  { slug: 'terrace-garden-in-palma' as string | undefined, ytId: '1q1Qnh2s_mg', label: '' },
  { slug: undefined as string | undefined, ytId: 'IzRNgQnHAXM', label: "S'Estepa Design · Mallorca" },
].map((s) => {
  if (s.slug) {
    const g = garden(s.slug);
    if (g) return { ytId: s.ytId, label: `${g.title} · ${g.location}` };
  }
  return { ytId: s.ytId, label: s.label || "S'Estepa Design · Mallorca" };
});

// --- The Journal: hand-picked lead-facing articles ---
const curatedSlugs = [
  'the-ultimate-guide-to-high-end-garden-design-in-mallorca',
  'the-compounding-landscape',
  'regenerative-landscapes-despite-mallorcas-water-realities',
  'beyond-aesthetics-invest-in-an-ecosystem-that-multiplies-the-value-of-your-property-in-mallorca',
];
const articleImagePool = [
  '/portfolio/sant-llorenc/images/garden-design-mallorca-sestepa-landscape-design-sant-llorenc-15-card.webp',
  '/portfolio/finca-garden-campos-mallorca/garden-design-mallorca-finca-garden-campos-mallorca-sestepa-card.webp',
  '/portfolio/crestatx-garden-design/garden-design-mallorca-crestatx-garden-design-sestepa-card.webp',
  '/portfolio/garden-design-llubi-mallorca/images/landscape-architecture-mallorca-llubi-sestepa-design%20(1)-card.webp',
];
function postSlug(id: string) {
  return id.replace(/\.md$/, '').split('/').pop() ?? id;
}
function postUrl(slug: string) {
  if (lang === 'en') return `/${slug}/`;
  return `${getPagePath('blog', lang).replace(/\/$/, '')}/${slug}/`;
}
const allPosts = (await getCollection('blog'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const bySlug = new Map(allPosts.map((p) => [postSlug(p.id), p]));
const curated = curatedSlugs.map((s) => bySlug.get(s)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const journalPosts = (curated.length ? curated : allPosts.slice(0, 3)).map((post, i) => {
  const slug = postSlug(post.id);
  const wordCount = post.body ? post.body.split(/\s+/).length : 0;
  return {
    slug,
    url: postUrl(slug),
    title: post.data.title,
    description: post.data.description,
    readingTime: Math.max(1, Math.ceil(wordCount / 200)),
    image: post.data.image || articleImagePool[i % articleImagePool.length],
  };
});

const total = heroSlides.length;
---

<Layout title={`S'Estepa Design | ${meta.title}`} description={meta.description} lang={lang}>
  <!-- Masthead -->
  <header class="jmast">
    <div class="container jmast-inner">
      <span class="jmast-kicker">{meta.eyebrow}</span>
      <h1 class="jmast-title">{meta.title}</h1>
      <p class="jmast-sub">{meta.subtitle}</p>
      <p class="jmast-sub-it">{meta.taglineItalic}</p>
    </div>
  </header>

  <!-- Hero — editorial 2/3 · 1/3 slider -->
  <section class="jhero" id="jhero" tabindex="0" aria-roledescription="carousel" aria-label={meta.title}>
    <div class="jhero-media" id="jheroMedia">
      {heroSlides.map((g, i) => (
        <figure class={`jhero-slide ${i === 0 ? 'is-active' : ''}`} data-i={i} aria-hidden={i !== 0 ? 'true' : 'false'}>
          <picture>
            {g.coverSrcset && <source media="(max-width: 900px)" srcset={g.coverSrcset} />}
            <img
              src={g.cover}
              alt={`${g.title} — Garden Design ${g.location}, S'Estepa Design`}
              class="jhero-img"
              width="1600"
              height="1200"
              fetchpriority={i === 0 ? 'high' : undefined}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </picture>
          <figcaption class="jhero-slide-cap">
            <span class="jhero-slide-cat">{g.category} · {g.location}</span>
            <span class="jhero-slide-name">{g.title}</span>
          </figcaption>
        </figure>
      ))}
      <button class="jhero-zone jhero-zone-prev" type="button" aria-label="Previous garden" tabindex="-1"></button>
      <button class="jhero-zone jhero-zone-next" type="button" aria-label="Next garden" tabindex="-1"></button>
    </div>

    <div class="jhero-panel">
      <span class="jhero-panel-tag">{meta.heroPanelTag}</span>

      <div class="jhero-panel-slide">
        {heroSlides.map((g, i) => (
          <div class={`jhero-ps ${i === 0 ? 'is-active' : ''}`} data-i={i}>
            <span class="jhero-ps-meta">{g.category} · {g.location} · {g.year}{g.size ? ` · ${g.size}` : ''}</span>
            <p class="jhero-ps-sub">{g.subtitle}</p>
            <p class="jhero-ps-desc">{g.descIntro}</p>
            <a href={g.href} class="jhero-ps-link">{meta.viewGarden} &rarr;</a>
          </div>
        ))}
      </div>

      <div class="jhero-panel-nav">
        <span class="jhero-count"><b id="jheroNum">01</b> &nbsp;&#47;&nbsp; {String(total).padStart(2, '0')}</span>
        <div class="jhero-dots" role="tablist" aria-label="Select garden">
          {heroSlides.map((_, i) => (
            <button class={`jhero-dot ${i === 0 ? 'is-active' : ''}`} data-i={i} type="button" aria-label={`Garden ${i + 1}`}></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work — auto, gestural carousel -->
  <section class="blog-works section-padding">
    <div class="container">
      <div class="works-head">
        <div>
          <span class="section-tag">{meta.worksTag}</span>
          <h2 class="works-title">{meta.worksTitle}</h2>
          <p class="works-desc">{meta.worksDesc}</p>
        </div>
        <a href={getPagePath('portfolio', lang)} class="text-link">{meta.worksCta} &rarr;</a>
      </div>
    </div>

    <div class="pf" id="pfCar" tabindex="0" role="region" aria-label={meta.carouselLabel}>
      <ul class="pf-track" id="pfTrack">
        {stripGardens.map((g) => (
          <li class="pf-item">
            <a href={g.href} class="pf-card" draggable="false">
              <div class="pf-img-wrap">
                <picture>
                  {g.coverSrcset && <source media="(max-width: 768px)" srcset={g.coverSrcset} />}
                  <img src={g.cover} alt={`${g.title} — Garden Design ${g.location}, S'Estepa Design`} class="pf-img" loading="lazy" decoding="async" width="640" height="480" draggable="false" />
                </picture>
              </div>
              <span class="pf-cat">{g.category}</span>
              <span class="pf-name">{g.title}</span>
              <span class="pf-sub">{g.subtitle}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pf-scrub" id="pfScrub" role="slider" tabindex="0" aria-label={meta.carouselLabel} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="pf-scrub-fill" id="pfBar"></span>
        <span class="pf-scrub-knob" id="pfKnob"></span>
      </div>
    </div>
  </section>

  <!-- On Film — YouTube facades, uniform -->
  {films.length > 0 && (
    <section class="blog-film section-padding">
      <div class="container">
        <span class="section-tag center">{meta.filmTag}</span>
        <h2 class="section-heading center">{meta.filmTitle}</h2>
        <p class="section-desc center">{meta.filmDesc}</p>

        <div class="film-grid">
          {films.map((f) => (
            <figure class="film-card">
              <div class="film-frame">
                <button class="film-facade" type="button" data-yt={f.ytId} aria-label={`${meta.playLabel} — ${f.title}`}>
                  <img
                    src={`https://i.ytimg.com/vi/${f.ytId}/maxresdefault.jpg`}
                    onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${f.ytId}/hqdefault.jpg'`}
                    alt={`${f.title} — S'Estepa Design`}
                    class="film-thumb"
                    loading="lazy"
                    decoding="async"
                    width="1280"
                    height="720"
                  />
                  <span class="film-play" aria-hidden="true"></span>
                </button>
              </div>
              <figcaption class="film-meta">
                <span class="film-name">{f.title}</span>
                <span class="film-loc">{f.location}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        {shorts.length > 0 && (
          <div class="shorts-row">
            <span class="shorts-label">{meta.shortsTitle} <span class="shorts-sub">— {meta.shortsDesc}</span></span>
            <div class="shorts-grid">
              {shorts.map((s) => (
                <div class="short-card">
                  <div class="short-frame">
                    <button class="film-facade" type="button" data-yt={s.ytId} data-short="1" aria-label={`${meta.playLabel} — ${s.label}`}>
                      <img
                        src={`https://i.ytimg.com/vi/${s.ytId}/oar2.jpg`}
                        onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${s.ytId}/hqdefault.jpg'`}
                        alt={`${s.label} — S'Estepa Design`}
                        class="film-thumb"
                        loading="lazy"
                        decoding="async"
                        width="720"
                        height="1280"
                      />
                      <span class="film-play" aria-hidden="true"></span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- The Journal -->
  {journalPosts.length > 0 && (
    <section class="blog-journal section-padding">
      <div class="container">
        <span class="section-tag center">{meta.journalTag}</span>
        <h2 class="section-heading center">{meta.journalTitle}</h2>
        <p class="section-desc center">{meta.journalDesc}</p>
      </div>

      <div class="jrnl" id="jrnlCar" tabindex="0" role="region" aria-label={meta.journalTitle}>
        <ul class="jrnl-track" id="jrnlTrack">
          {journalPosts.map((post) => (
            <li class="jrnl-item">
              <article class="journal-card">
                <a href={post.url} class="journal-image-link">
                  <img src={post.image} alt={post.title} class="journal-image" loading="lazy" decoding="async" width="600" height="420" draggable="false" />
                </a>
                <div class="journal-body">
                  <div class="journal-meta">
                    <span class="brand">S'ESTEPA STUDIO</span>
                    <span class="dot">·</span>
                    <span class="read-time">{post.readingTime} MIN READ</span>
                  </div>
                  <h3 class="journal-title"><a href={post.url}>{post.title}</a></h3>
                  <p class="journal-excerpt">{post.description}</p>
                  <a href={post.url} class="read-more">{meta.readArticle} <span class="arrow">&rarr;</span></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="jrnl-scrub" id="jrnlScrub" role="slider" tabindex="0" aria-label={meta.journalTitle} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="jrnl-scrub-fill" id="jrnlBar"></span>
          <span class="jrnl-scrub-knob" id="jrnlKnob"></span>
        </div>
      </div>
    </section>
  )}

  <!-- Closing CTA -->
  <section class="blog-cta">
    <div class="container blog-cta-inner">
      <h2 class="blog-cta-title">{meta.ctaTitle}</h2>
      <p class="blog-cta-desc">{meta.ctaDesc}</p>
      <div class="blog-cta-actions">
        <a href={getPagePath('contact', lang)} class="blog-cta-btn">{meta.ctaButton} &rarr;</a>
        <a href={whatsappUrl} class="blog-cta-link" target="_blank" rel="noopener noreferrer">WhatsApp +34 681 272 252</a>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------- Hero slider: tap-zones · swipe · keyboard · auto ---------- */
      (function () {
        var hero = document.getElementById('jhero');
        if (!hero) return;
        var media = document.getElementById('jheroMedia');
        var slides = [].slice.call(hero.querySelectorAll('.jhero-slide'));
        var panels = [].slice.call(hero.querySelectorAll('.jhero-ps'));
        var dots = [].slice.call(hero.querySelectorAll('.jhero-dot'));
        var num = document.getElementById('jheroNum');
        var i = 0;
        var timer = null;

        function show(n) {
          i = (n + slides.length) % slides.length;
          slides.forEach(function (s, k) {
            s.classList.toggle('is-active', k === i);
            s.setAttribute('aria-hidden', k === i ? 'false' : 'true');
          });
          panels.forEach(function (p, k) { p.classList.toggle('is-active', k === i); });
          dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
          if (num) num.textContent = ('0' + (i + 1)).slice(-2);
        }
        function go(step) { show(i + step); ping(); }
        function ping() { stop(); if (!reduce) timer = setInterval(function () { show(i + 1); }, 6500); }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }

        [].forEach.call(hero.querySelectorAll('.jhero-zone'), function (z) {
          z.addEventListener('mousedown', function (e) { e.preventDefault(); }); // never take focus
          z.addEventListener('click', function () {
