---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../data/translations';
import { servicesContent } from '../../data/services';
import { getPagePath } from '../../lib/urls';
import { projects, getProjectLocation } from '../../data/projects';
import ProjectCard from '../ProjectCard.astro';
import NonResidentOwners from '../NonResidentOwners.astro';
import type { SitePageId } from '../../data/site-urls';

interface Props { lang: 'en' | 'es' | 'de'; }
const { lang } = Astro.props;
const content = servicesContent[lang];

const t = (key: keyof (typeof ui)[typeof lang]) => ui[lang][key] || key;

// Hero background — a project shot distinct from the homepage hero.
const heroImage =
  '/portfolio/crestatx-garden-design/garden-design-mallorca-crestatx-garden-design-sestepa.webp';

const heroCta = {
  en: 'Start a conversation',
  es: 'Empecemos a hablar',
  de: 'Sprechen wir darüber',
}[lang];
---

<Layout
  title={content.seoTitle || `S'Estepa Design | ${content.title}`}
  description={content.metaDescription}
  lang={lang}
>
  <section class="svc-hero">
    <img class="svc-hero-bg" src={heroImage} alt="" loading="eager" fetchpriority="high" />
    <div class="svc-hero-veil"></div>
    <div class="svc-hero-inner">
      <span class="section-tag">{content.tag}</span>
      <h1 class="svc-hero-title">{content.heroHeadline}</h1>
      <p class="svc-hero-lead">{content.heroLead}</p>
      <a href={getPagePath('contact', lang)} class="cta-button svc-hero-cta">{heroCta}</a>
    </div>
  </section>

  <article class="services-page section-padding">
    <div class="container">
      <header class="page-header">
        <h2 class="page-title">{content.title}</h2>
        {content.subtitle && <p class="page-subtitle">{content.subtitle}</p>}
        <p class="page-intro">{content.intro}</p>
      </header>

      <div class="services-grid">
        {content.items.map((item, index) => (
          <section class="service-card">
            <div class="category-icon-wrapper">
              {index === 0 && (
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 21V9l8-5 8 5v12H4z" />
                  <path d="M9 21v-8h6v8" />
                  <path d="M7 9h10" />
                </svg>
              )}
              {index === 1 && (
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v3" />
                  <path d="M12 5L7 20" />
                  <path d="M12 5l5 15" />
                  <path d="M9 14h6" />
                  <circle cx="12" cy="5" r="1.5" />
                </svg>
              )}
              {index === 2 && (
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 20H4v-4h16v4z" />
                  <path d="M14 16H4v-4h10v4z" />
                  <path d="M20 16h-6v-4h6v4z" />
                  <path d="M10 12H4V8h6v4z" />
                  <path d="M20 12H10V8h10v4z" />
                </svg>
              )}
              {index === 3 && (
                <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-13-7-13S5 10.7 5 15a7 7 0 0 0 7 7z" />
                  <path d="M12 9v9" />
                  <path d="M12 12s2 1.5 2 3" />
                  <path d="M12 14s-2 1.5-2 3" />
                </svg>
              )}
            </div>
            <h2 class="service-title">{item.title}</h2>
            <p class="service-text">{item.text}</p>
          </section>
        ))}
      </div>



      <section class="services-list-section">
        <h2 class="services-list-heading">
          {lang === 'en' && 'Our Services'}
          {lang === 'es' && 'Nuestros Servicios'}
          {lang === 'de' && 'Unsere Leistungen'}
        </h2>
        <ul class="services-bullets">
          {lang === 'es' && (
            <>
              <li>Concepción, ejecución llave en mano y mantenimiento de jardines, fincas y terrazas.</li>
              <li>Análisis previo del terreno, topografía y composición del suelo calcáreo.</li>
              <li>Propuesta conceptual, planos a escala 2D y visualización arquitectónica 3D.</li>
              <li>Definición del trazado general del jardín, zonificación e integración de terrazas y piscinas.</li>
              <li>Selección botánica mediterránea y composición de plantaciones resilientes.</li>
              <li>Suministro y plantación de ejemplares monumentales y árboles centenarios (olivos, algarrobos, cipreses).</li>
              <li>Construcción tradicional en piedra seca mallorquina (marges de pedra en sec) y obra civil de paisaje.</li>
              <li>Xerojardinería mediterránea, hidro-zonificación y sistemas inteligentes de riego por goteo subterráneo.</li>
              <li>Desarrollo de la documentación técnica y constructiva del proyecto.</li>
              <li>Elaboración de presupuestos desglosados por fases.</li>
              <li>Dirección de obra integral con equipo propio en Mallorca.</li>
              <li>Colaboración técnica con estudios de arquitectura, project managers, hoteles boutique y family offices.</li>
            </>
          )}
          {lang === 'en' && (
            <>
              <li>Turnkey design, full construction, and ecological care of estate gardens, villas, and terraces.</li>
              <li>Prior site analysis, topography, and calcareous soil assessment.</li>
              <li>Conceptual masterplans, 2D scaled technical layouts, and 3D architectural renders.</li>
              <li>General landscape zoning and seamless integration with pool terraces, pergolas, and outdoor living areas.</li>
              <li>Mediterranean botanical curation and drought-resilient planting composition.</li>
              <li>Sourcing and installation of mature and centenary specimen trees (ancient olives, carobs, cypresses).</li>
              <li>Traditional Mallorcan dry-stone walling (pedra en sec) and structural hardscaping.</li>
              <li>Mediterranean xeriscaping, hydro-zoning, and sub-surface drip irrigation engineering.</li>
              <li>Comprehensive technical and constructive documentation.</li>
              <li>Transparent, phase-by-phase budget preparation.</li>
              <li>In-house site direction and full project management.</li>
              <li>Direct technical collaboration with architects, project managers, boutique hotels, and family offices.</li>
            </>
          )}
          {lang === 'de' && (
            <>
              <li>Schlüsselfertige Planung, Bauausführung und Pflege von Finca-Gärten, Villen und Dachterrassen.</li>
              <li>Standortanalyse, Topografie und Untersuchung der kalkhaltigen Bodenbeschaffenheit.</li>
              <li>Konzeptionelle Masterpläne, maßstabsgetreue 2D-Pläne und 3D-Architekturvisualisierungen.</li>
              <li>Zonierung der Außenanlagen und nahtlose Integration von Poolterrassen und Pergolen.</li>
              <li>Mediterrane Pflanzplanung: Auswahl und Komposition trockenheitsresistenter Flora.</li>
              <li>Beschaffung und Pflanzung jahrhundertealter Solitärbäume (alte Olivenbäume, Johannisbrotbäume, Zypressen).</li>
              <li>Traditioneller mallorquinischer Trockensteinmauerbau (Pedra en sec) und Erdarbeiten.</li>
              <li>Mediterranes Xeriscaping, Hydro-Zonierung und unterirdische Tropfbewässerungssysteme.</li>
              <li>Erstellung der vollständigen technischen Ausführungsunterlagen.</li>
              <li>Transparente, nach Bauphasen aufgeschlüsselte Budgeterstellung.</li>
              <li>Komplette Bauleitung vor Ort durch unser eigenes mallorquinisches Team.</li>
              <li>Direkte Fachkooperation mit Architekten, Projektmanagern, Boutique-Hotels und Family Offices.</li>
            </>
          )}
        </ul>

        <div class="expertise-hub-links">
          <a href={getPagePath('large-scale-projects', lang)} class="expertise-hub-card">
            <span class="expertise-hub-tag">
              {lang === 'en' && 'Estate-Scale Work'}
              {lang === 'es' && 'Proyectos a Escala de Finca'}
              {lang === 'de' && 'Arbeiten im Anwesensmaßstab'}
            </span>
            <h3 class="expertise-hub-title">{t('nav.largeScaleProjects')} &rarr;</h3>
            <p class="expertise-hub-desc">
              {lang === 'en' && 'Explore how we design, build and plant multi-hectare fincas and private estates across Mallorca end-to-end.'}
              {lang === 'es' && 'Descubra cómo diseñamos, construimos y plantamos fincas de varias hectáreas y grandes propiedades privadas en Mallorca.'}
              {lang === 'de' && 'Erfahren Sie, wie wir weitläufige Fincas und private Landgüter auf Mallorca schlüsselfertig planen, bauen und bepflanzen.'}
            </p>
          </a>
          <a href={getPagePath('botanical-expertise', lang)} class="expertise-hub-card">
            <span class="expertise-hub-tag">
              {lang === 'en' && 'Botanical & Soil Engineering'}
              {lang === 'es' && 'Ingeniería Botánica y Suelo'}
              {lang === 'de' && 'Botanik & Bodenexpertise'}
            </span>
            <h3 class="expertise-hub-title">{t('nav.botanicalExpertise')} &rarr;</h3>
            <p class="expertise-hub-desc">
              {lang === 'en' && 'Calcareous ground, Call Vermell clay, Tramuntana windbreaks and sub-surface drip irrigation tailored to the island.'}
              {lang === 'es' && 'Terreno calcáreo, arcilla Call Vermell, cortavientos para la Tramuntana y riego subterráneo adaptado a la isla.'}
              {lang === 'de' && 'Kalkhaltiger Boden, Call-Vermell-Lehm, Tramuntana-Windschutz und wassersparende Unterflurbewässerung.'}
            </p>
          </a>
        </div>
      </section>

      <NonResidentOwners lang={lang} />

      <div class="cta-panel">
        <p>
          {lang === 'en' && 'Mediterranean gardens with an authentic Mallorcan DNA.'}
          {lang === 'es' && 'Jardines mediterráneos con un ADN mallorquín auténtico.'}
          {lang === 'de' && 'Mediterrane Gärten mit authentischer mallorquinischer DNA.'}
        </p>
        <a href={getPagePath('contact', lang)} class="cta-button">
          {t('contact.form.submit')}
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .services-page {
    padding-top: 4rem;
  }

  @media (max-width: 768px) {
    .services-page {
      padding-top: 3rem;
    }
  }

  /* Hero */
  .svc-hero {
    position: relative;
    min-height: 76vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 5rem; /* clear the fixed header */
  }

  .svc-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .svc-hero-veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(31, 33, 31, 0.72) 0%,
      rgba(31, 33, 31, 0.28) 45%,
      rgba(31, 33, 31, 0.12) 100%
    );
  }

  .svc-hero-inner {
    position: relative;
    z-index: 3;
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 3rem var(--spacing-md);
    color: var(--color-white);
  }

  .svc-hero-inner .section-tag {
    color: var(--color-sand-dark);
  }

  .svc-hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-white);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.15;
    max-width: 22ch;
    margin: 1rem 0 1.25rem;
  }

  .svc-hero-lead {
    font-size: 1.08rem;
    line-height: 1.75;
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 2rem;
  }

  .svc-hero-cta {
    background: var(--color-white);
    color: var(--color-charcoal);
  }

  @media (max-width: 768px) {
    .svc-hero {
      min-height: 70vh;
    }
    .svc-hero-inner {
      padding-bottom: 3rem;
    }
  }

  /* Projects strip */
  .svc-strip {
    margin-bottom: 5rem;
  }

  .svc-strip-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .svc-strip-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 400;
    color: var(--color-charcoal);
    max-width: 24ch;
  }

  .svc-strip-link {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-olive);
    white-space: nowrap;
  }

  .svc-strip-scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(300px, 1fr);
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    -webkit-overflow-scrolling: touch;
  }

  .svc-strip-item {
    scroll-snap-align: start;
  }

  @media (min-width: 1100px) {
    .svc-strip-scroll {
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row;
      overflow: visible;
    }
  }

  .page-header {
    max-width: 820px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin: 1rem 0;
    color: var(--color-charcoal);
  }

  .page-subtitle,
  .page-intro {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-charcoal-light);
  }

  .page-intro {
    margin-top: 1.5rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .service-card {
    background: var(--color-white);
    padding: 2.5rem 2rem;
    border: 1px solid var(--color-sand-dark);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .category-icon-wrapper {
    margin-bottom: 2rem;
  }

  .service-icon {
    width: 28px;
    height: 28px;
    color: var(--color-olive);
  }

  .service-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: var(--color-olive);
  }

  .service-text {
    line-height: 1.75;
    color: var(--color-charcoal-light);
    margin-bottom: 1.5rem;
  }

  .service-link {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-charcoal);
    border-bottom: 1px solid var(--color-olive);
    padding-bottom: 0.2rem;
  }

  .cta-panel {
    text-align: center;
    padding: 3rem;
    background: var(--color-sand-base);
    margin-top: 5rem;
  }

  .cta-panel p {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 1.5rem;
    color: var(--color-charcoal);
  }

  .cta-button {
    display: inline-block;
    padding: 0.9rem 2rem;
    background: var(--color-olive);
    color: var(--color-white);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  .services-list-section {
    margin-top: 5rem;
    border-top: 1px solid var(--color-sand-dark);
    padding-top: 4rem;
  }

  .services-list-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 400;
    color: var(--color-charcoal);
    margin-bottom: 2.5rem;
  }

  .services-bullets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
    padding-left: 0;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .services-bullets {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services-bullets {
      grid-template-columns: 1fr;
    }
  }

  .services-bullets li {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-charcoal-light);
    position: relative;
    padding-left: 1.5rem;
  }

  .services-bullets li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-olive);
    font-size: 1.25rem;
  }

  .expertise-hub-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-sand-dark);
  }

  .expertise-hub-card {
    display: block;
    padding: 2.25rem 2rem;
    background: var(--color-sand-light);
    border: 1px solid var(--color-sand-dark);
    transition: var(--transition-fast);
  }

  .expertise-hub-card:hover {
    border-color: var(--color-olive);
    transform: translateY(-2px);
  }

  .expertise-hub-tag {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-olive);
    margin-bottom: 0.6rem;
  }

  .expertise-hub-title {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--color-charcoal);
    margin: 0 0 0.75rem;
  }

  .expertise-hub-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-charcoal-light);
    margin: 0;
  }

  @media (max-width: 768px) {
    .expertise-hub-links {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>



