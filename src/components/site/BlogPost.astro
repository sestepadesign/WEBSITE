---
import Layout from '../../layouts/Layout.astro';
import { render, getCollection, type CollectionEntry } from 'astro:content';
import { getPagePath } from '../../lib/urls';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: 'en' | 'es' | 'de';
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
  /** hreflang <link>s for this post across locales; omit for EN-only posts. */
  alternates?: { hreflang: string; href: string }[];
}

const { post, lang, prev = null, next = null, alternates } = Astro.props;
const { Content } = await render(post);

const clean = (s: string) =>
  s.replace(/&#038;/g, '&').replace(/&#8217;/g, "'").replace(/&#8216;/g, "'").replace(/&#8221;/g, '"').replace(/&#8220;/g, '"');

const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const t = {
  en: { nav: 'Journal navigation', previous: 'Previous', journal: 'Journal', next: 'Next', studio: "S'Estepa Studio", read: 'min read', more: 'Keep reading', moreScroll: 'More articles' },
  es: { nav: 'Navegación del diario', previous: 'Anterior', journal: 'Diario', next: 'Siguiente', studio: "Estudio S'Estepa", read: 'min de lectura', more: 'Seguir leyendo', moreScroll: 'Más artículos' },
  de: { nav: 'Journal-Navigation', previous: 'Zurück', journal: 'Journal', next: 'Weiter', studio: "S'Estepa Studio", read: 'Min. Lesezeit', more: 'Weiterlesen', moreScroll: 'Weitere Artikel' },
}[lang];
const journalPath = getPagePath('blog', lang);

const fallbackImage = '/portfolio/finca-garden-campos-mallorca/garden-design-mallorca-finca-garden-campos-mallorca-sestepa.webp';

// ── End-of-post carousel: other Journal articles, same locale ─────────
const postSlugOf = (id: string) => id.replace(/\.md$/, '').split('/').pop()!;
const currentSlug = postSlugOf(post.id);
const relHref = (slug: string) =>
  lang === 'es' ? `/es/blog/${slug}/` : lang === 'de' ? `/de/blog/${slug}/` : `/${slug}/`;

// The curated lead articles (same set as the /blog/ index carousel), in order,
// minus the post being read. Same-locale only, so ES/DE show their translations.
const leadSlugs = [
  'the-ultimate-guide-to-high-end-garden-design-in-mallorca',
  'the-compounding-landscape',
  'regenerative-landscapes-despite-mallorcas-water-realities',
  'beyond-aesthetics-invest-in-an-ecosystem-that-multiplies-the-value-of-your-property-in-mallorca',
];
// A few lead articles carry no `image:` frontmatter — give each a stable cover
// so the same post always shows the same photo, whichever post you came from.
const coverBySlug: Record<string, string> = {
  'the-ultimate-guide-to-high-end-garden-design-in-mallorca':
    '/portfolio/crestatx-garden-design/garden-design-mallorca-crestatx-garden-design-sestepa-card.webp',
  'regenerative-landscapes-despite-mallorcas-water-realities':
    '/portfolio/sant-llorenc/images/garden-design-mallorca-sestepa-landscape-design-sant-llorenc-15-card.webp',
  'beyond-aesthetics-invest-in-an-ecosystem-that-multiplies-the-value-of-your-property-in-mallorca':
    '/portfolio/garden-design-llubi-mallorca/images/landscape-architecture-mallorca-llubi-sestepa-design%20(1)-card.webp',
};
const blogPosts = await getCollection('blog', ({ data }) => !data.draft && !data.noindex);
const relatedPosts = leadSlugs
  .filter((s) => s !== currentSlug)
  .map((s) => blogPosts.find((p) => p.data.lang === lang && postSlugOf(p.id) === s))
  .filter((p): p is CollectionEntry<'blog'> => Boolean(p))
  .map((p) => {
    const slug = postSlugOf(p.id);
    return {
      title: p.data.title,
      href: relHref(slug),
      image: p.data.image ?? coverBySlug[slug] ?? fallbackImage,
      readingTime: Math.max(1, Math.ceil((p.body ? p.body.split(/\s+/).length : 0) / 200)),
    };
  });
---

<Layout
  title={clean(post.data.title) + " | S'Estepa Design"}
  description={post.data.description}
  lang={lang}
  image={post.data.image ?? fallbackImage}
  hreflangLocales={alternates && alternates.length ? undefined : ['en']}
  hreflangAlternates={alternates}
  noindex={post.data.noindex}
>
  <section class="blog-hero">
    <div class="bh-inner">
      <span class="bh-rule" aria-hidden="true"></span>
      <h1 class="bh-title" set:html={post.data.title} />
    </div>
  </section>

  <article class="container section-padding blog-post" id="blog-content">
    <div class="blog-column">
      <header class="blog-lead">
        <nav class="blog-lead-nav" aria-label={t.nav}>
          {prev ? (
            <a href={prev.href} class="bln-link" title={clean(prev.title)} rel="prev">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
              <span class="bln-text">{t.previous}</span>
            </a>
          ) : (
            <span class="bln-spacer"></span>
          )}

          <a href={journalPath} class="bln-journal">{t.journal}</a>

          {next ? (
            <a href={next.href} class="bln-link" title={clean(next.title)} rel="next">
              <span class="bln-text">{t.next}</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          ) : (
            <span class="bln-spacer"></span>
          )}
        </nav>

        <p class="blog-lead-meta">
          <span>{t.studio}</span>
          <span class="sep" aria-hidden="true">&middot;</span>
          <span>{readingTime} {t.read}</span>
        </p>

        {post.data.description && (
          <p class="blog-lead-dek">{post.data.description}</p>
        )}
      </header>

      <div class="blog-content">
        <Content />
      </div>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <aside class="blog-more" aria-label={t.more}>
      <div class="blog-more-head">
        <span class="bm-rule" aria-hidden="true"></span>
        <h2 class="bm-title">{t.more}</h2>
        <a href={journalPath} class="bm-all">{t.journal} &rarr;</a>
      </div>

      <div class="bm-car" id="bmCar" role="region" aria-label={t.moreScroll} tabindex="0">
        <ul class="bm-track" id="bmTrack">
          {relatedPosts.map((p) => (
            <li class="bm-item">
              <article class="bm-card">
                <a href={p.href} class="bm-img-link" tabindex="-1" aria-hidden="true">
                  <img src={p.image} alt="" class="bm-img" loading="lazy" decoding="async" width="600" height="420" draggable="false" />
                </a>
                <div class="bm-body">
                  <span class="bm-meta">{t.studio} <span aria-hidden="true">&middot;</span> {p.readingTime} {t.read}</span>
                  <h3 class="bm-card-title"><a href={p.href}>{p.title}</a></h3>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="bm-ctrl" aria-hidden="true">
          <button type="button" class="bm-arrow" data-dir="-1" tabindex="-1">&larr;</button>
          <button type="button" class="bm-arrow" data-dir="1" tabindex="-1">&rarr;</button>
        </div>
      </div>
    </aside>
  )}
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var wrap = document.getElementById('bmCar');
    var track = document.getElementById('bmTrack');
    if (!wrap || !track) return;

    function step() {
      var c = track.querySelector('.bm-item');
      return c ? c.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
    }

    [].forEach.call(wrap.querySelectorAll('.bm-arrow'), function (b) {
      b.addEventListener('click', function () {
        track.scrollBy({ left: step() * (+b.dataset.dir), behavior: 'smooth' });
      });
    });
    wrap.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); track.scrollBy({ left: step(), behavior: 'smooth' }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); track.scrollBy({ left: -step(), behavior: 'smooth' }); }
    });

    // Mouse click-drag to scroll; a real drag (>8px) eats the click that follows
    // so card links still work on a plain click.
    var pid = null, x0 = 0, s0 = 0, dragging = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      pid = e.pointerId; x0 = e.clientX; s0 = track.scrollLeft; dragging = false;
    });
    track.addEventListener('pointermove', function (e) {
      if (e.pointerId !== pid) return;
      var dx = e.clientX - x0;
      if (!dragging) {
        if (Math.abs(dx) < 8) return;
        dragging = true;
        track.classList.add('is-dragging');
        try { track.setPointerCapture(pid); } catch (err) {}
      }
      e.preventDefault();
      track.scrollLeft = s0 - dx;
    });
    function endDrag(e) {
      if (pid === null || (e && e.pointerId !== pid)) return;
      try { track.releasePointerCapture(pid); } catch (err) {}
      pid = null;
      if (dragging) {
        track.classList.remove('is-dragging');
        var kill = function (ev) { ev.preventDefault(); ev.stopPropagation(); };
        track.addEventListener('click', kill, { capture: true, once: true });
        setTimeout(function () { track.removeEventListener('click', kill, true); }, 60);
      }
      dragging = false;
    }
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
  });
</script>

<style>
  /* ── Blog post masthead — typographic hero ───────────────────────── */
  .blog-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: clamp(25rem, 52vh, 31rem);
    padding: 9rem 1.5rem 3.5rem;
    background: linear-gradient(180deg, var(--color-sand-light) 0%, var(--color-sand-base) 100%);
    border-bottom: 1px solid var(--color-sand-dark);
    overflow: hidden;
  }
  .bh-inner {
    flex: 0 1 46rem;
    min-width: 0;
  }
  /* Safety net: keep the masthead a standard height even if a title is long.
     Titles are written to fit 2–3 lines; this only clips a stray over-long one. */
  .bh-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .bh-rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-olive);
    margin: 0 auto 1.9rem;
  }
  .bh-title {
    margin: 0 auto;
    max-width: 30ch;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-charcoal);
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    line-height: 1.22;
    letter-spacing: -0.006em;
    text-wrap: balance;
  }

  @media (max-width: 768px) {
    .blog-hero {
      height: clamp(20rem, 48vh, 26rem);
      padding: 8rem 1.25rem 2.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bh-rule  { animation: bhRise 0.9s cubic-bezier(0.25, 1, 0.5, 1) both; }
    .bh-title { animation: bhRise 0.9s 0.07s cubic-bezier(0.25, 1, 0.5, 1) both; }
  }
  @keyframes bhRise {
    from { opacity: 0; transform: translateY(0.9rem); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Article lead — nav, byline & standfirst on the page body ────── */
  .blog-column {
    width: 100%;
    max-width: 800px;
  }
  .blog-lead {
    margin-bottom: 3.25rem;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid var(--color-sand-dark);
    text-align: center;
  }
  .blog-lead-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100%, 26rem);
    margin: 0 auto 2.25rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--color-sand-dark);
    border-bottom: 1px solid var(--color-sand-dark);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .blog-lead-nav .bln-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-limestone);
  }
  .blog-lead-nav .bln-link:hover { color: var(--color-charcoal); }
  .blog-lead-nav .bln-link svg { width: 0.8rem; height: 0.8rem; flex-shrink: 0; }
  .blog-lead-nav .bln-journal {
    color: var(--color-charcoal);
    font-weight: 500;
    letter-spacing: 0.26em;
    padding-left: 0.26em;
  }
  .blog-lead-nav .bln-journal:hover { color: var(--color-olive); }
  .blog-lead-nav .bln-spacer { width: 4.5rem; }

  .blog-lead-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-limestone);
  }
  .blog-lead-meta .sep { opacity: 0.45; }

  .blog-lead-dek {
    margin: 1.5rem auto 0;
    max-width: 46ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--color-limestone);
    font-size: clamp(1.2rem, 1.9vw, 1.55rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    .blog-lead { margin-bottom: 2.5rem; padding-bottom: 2.25rem; }
    .blog-lead-nav {
      width: min(100%, 20rem);
      font-size: 0.6rem;
      margin-bottom: 1.75rem;
    }
    .blog-lead-nav .bln-text { display: none; }
    .blog-lead-nav .bln-spacer { width: 1.5rem; }
    .blog-lead-meta { font-size: 0.64rem; gap: 0.4rem; }
    .blog-lead-dek { margin-top: 1.2rem; }
  }

  /* ── End-of-post carousel — more from the Journal ────────────────── */
  .blog-more {
    margin: 0;
    padding: 3.5rem 0 5rem;
    border-top: 1px solid var(--color-sand-dark);
    background: var(--color-sand-light);
  }
  .blog-more-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0 max(1.5rem, calc((100vw - 1400px) / 2 + 1.5rem)) 2rem;
  }
  .bm-rule {
    flex: 0 0 auto;
    width: 2rem;
    height: 1px;
    background: var(--color-olive);
    transform: translateY(-0.4rem);
  }
  .bm-title {
    flex: 1 1 auto;
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--color-charcoal);
    letter-spacing: 0.01em;
  }
  .bm-all {
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-limestone);
    white-space: nowrap;
  }
  .bm-all:hover { color: var(--color-olive); }

  .bm-car { position: relative; outline: none; }
  .bm-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0.5rem max(1.5rem, calc((100vw - 1400px) / 2 + 1.5rem));
    list-style: none;
    margin: 0;
  }
  .bm-track::-webkit-scrollbar { display: none; }
  .bm-track.is-dragging { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; }
  .bm-track.is-dragging .bm-img { transition: none; }
  .bm-item {
    flex: 0 0 clamp(260px, 30vw, 320px);
    scroll-snap-align: start;
  }
  .bm-card { display: flex; flex-direction: column; height: 100%; }
  .bm-img-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-sand-dark);
  }
  .bm-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .bm-card:hover .bm-img { transform: scale(1.04); }
  .bm-body { padding: 1.1rem 0 0; }
  .bm-meta {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-limestone);
    margin-bottom: 0.5rem;
  }
  .bm-card-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.14rem;
    line-height: 1.32;
    color: var(--color-charcoal);
  }
  .bm-card-title a { color: inherit; }
  .bm-card-title a:hover { color: var(--color-olive); }

  .bm-ctrl {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0 max(1.5rem, calc((100vw - 1400px) / 2 + 1.5rem));
  }
  .bm-arrow {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-sand-dark);
    background: transparent;
    color: var(--color-limestone);
    font-size: 0.9rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .bm-arrow:hover { color: var(--color-charcoal); border-color: var(--color-olive-light); }

  @media (hover: none) {
    .bm-ctrl { display: none; }
  }
  @media (max-width: 768px) {
    .blog-more { padding: 2.75rem 0 3.5rem; }
    .blog-more-head { padding-bottom: 1.5rem; flex-wrap: wrap; }
    .bm-rule { display: none; }
    .bm-track { gap: 1.25rem; padding-left: 1.25rem; padding-right: 1.25rem; }
    .bm-item { flex-basis: clamp(240px, 78vw, 300px); }
  }
</style>
