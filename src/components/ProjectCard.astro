---
import { ui } from '../data/translations';
import { getProjectPath } from '../lib/urls';

interface Props {
  slug: string;
  title: string;
  category: string;
  location: string;
  cover: string;
  lang: 'en' | 'es' | 'de';
  large?: boolean;
  size?: string;
  extraImages?: string[];
  /** Optional smaller pre-generated variant for `cover`, used at this card's actual render size instead of the (often much larger) source file. */
  coverSrcset?: string;
  /** Same idea as `coverSrcset`, one entry per `extraImages` item, same order. */
  extraImagesSrcset?: string[];
}

const {
  slug,
  title,
  category,
  location,
  cover,
  lang,
  large = false,
  size,
  extraImages,
  coverSrcset,
  extraImagesSrcset,
} = Astro.props;
---

<a href={getProjectPath(slug, lang)} class:list={['project-card', { 'project-card-large': large }]}>
  <div class="image-wrapper-container">
    <div class="image-wrapper main-image-wrapper">
      <img
        src={cover}
        srcset={coverSrcset}
        sizes={coverSrcset ? '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 700px' : undefined}
        alt={`Garden Design ${location} — S'Estepa Design`}
        class="project-image"
        loading="lazy"
        decoding="async"
        width="800"
        height="600"
      />
      <div class="overlay">
        <span class="view-project">{ui[lang]['nav.portfolio'] || 'Explore'} &rarr;</span>
      </div>
    </div>

    {large && extraImages && extraImages.length >= 2 && (
      <div class="extra-images-column">
        {extraImages.slice(0, 2).map((img, i) => (
          <div class="image-wrapper extra-image-wrapper">
            <img
              src={img}
              srcset={extraImagesSrcset?.[i]}
              sizes={extraImagesSrcset?.[i] ? '(max-width: 767px) 50vw, 350px' : undefined}
              alt={`Garden Detail ${location} — S'Estepa Design`}
              class="project-image"
              loading="lazy"
              decoding="async"
              width="400"
              height="300"
            />
            <div class="overlay">
              <span class="view-project">{ui[lang]['nav.portfolio'] || 'Explore'} &rarr;</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
  <div class="project-info">
    <span class="project-category">{category}</span>
    <h3 class="project-title">{title}</h3>
    <span class="project-location">{location}{size && <span class="project-size"> · {size}</span>}</span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    group: hover;
    text-decoration: none;
    color: inherit;
  }

  .image-wrapper-container {
    display: flex;
    width: 100%;
    gap: 0.5rem;
  }

  .main-image-wrapper {
    flex: 2.15;
  }

  .extra-images-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .extra-image-wrapper {
    flex: 1;
  }

  .project-card-large .image-wrapper-container {
    aspect-ratio: 21 / 9;
  }

  .project-card-large .project-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  @media (max-width: 768px) {
    .extra-images-column {
      display: none;
    }
    .project-card-large .image-wrapper-container {
      aspect-ratio: 4 / 3;
    }
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-sand-base);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(31, 33, 31, 0.15);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .view-project {
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border-bottom: 1px solid var(--color-white);
    padding-bottom: 0.25rem;
    transform: translateY(10px);
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Hover interactions */
  .project-card:hover .project-image {
    transform: scale(1.06);
  }

  .project-card:hover .overlay {
    opacity: 1;
  }

  .project-card:hover .view-project {
    transform: translateY(0);
  }

  /* Info styling */
  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .project-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-olive);
    font-weight: 500;
  }

  .project-title {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--color-charcoal);
    line-height: 1.2;
    transition: color var(--transition-fast);
  }

  .project-card:hover .project-title {
    color: var(--color-olive-dark);
  }

  .project-location {
    font-size: 0.85rem;
    color: var(--color-limestone);
    letter-spacing: 0.02em;
  }

  .project-size {
    color: var(--color-olive);
    font-weight: 500;
  }
</style>
